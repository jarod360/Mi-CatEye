@@ -0,0 +1,60 @@
+package nl.rogro82.pipup
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.view.View
+import android.view.WindowManager
+
+/** User-initiated in-call foreground ownership; video and controls remain in the overlay. */
+class DoorbellCallActivity : Activity() {
+    private var owner: DoorbellTalk? = null
+    private var started = false
+    private val handler = Handler(Looper.getMainLooper())
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        owner = pending; pending = null
+        if (owner == null) { finish(); return }
+        current = this
+        window.addFlags(WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE or WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        setContentView(View(this))
+        overridePendingTransition(0, 0)
+    }
+    override fun onResume() {
+        super.onResume()
+        if (!started) {
+            started = true
+            handler.postDelayed({ if (!isFinishing) owner?.foregroundReady(this) }, 250)
+        }
+    }
+    internal fun finishFromOwner() {
+        owner = null
+        finish(); overridePendingTransition(0, 0)
+    }
+    override fun onStop() { owner?.stop(); super.onStop() }
+    override fun onDestroy() {
+        handler.removeCallbacksAndMessages(null)
+        owner?.stop(); owner = null
+        if (current === this) current = null
+        super.onDestroy()
+    }
+    companion object {
+        private var pending: DoorbellTalk? = null
+        private var current: DoorbellCallActivity? = null
+        internal fun launch(context: Context, owner: DoorbellTalk): Boolean {
+            if (pending != null || current?.owner != null) return false
+            pending = owner
+            return try {
+                context.startActivity(Intent(context, DoorbellCallActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_NO_ANIMATION))
+                true
+            } catch (_: Exception) { pending = null; false }
+        }
+        internal fun cancelWaiting(owner: DoorbellTalk) {
+            if (pending === owner) pending = null
+            if (current?.owner === owner) current?.finishFromOwner()
+        }
+    }
+}
diff --git a/app/src/main/java/nl/rogro82/pipup/DoorbellTalk.kt b/app/src/main/java/nl/rogro82/pipup/DoorbellTalk.kt
new file mode 100644
index 0000000..d60816f
--- /dev/null
+++ b/app/src/main/java/nl/rogro82/pipup/DoorbellTalk.kt
@@ -0,0 +1,272 @@
+package nl.rogro82.pipup
+
+import android.Manifest
+import android.content.Context
+import android.content.pm.PackageManager
+import android.media.AudioFormat
+import android.media.AudioRecord
+import android.media.AudioTrack
+import android.media.AudioManager
+import android.media.AudioAttributes
+import android.media.AudioFocusRequest
+import android.media.audiofx.AcousticEchoCanceler
+import android.media.MediaRecorder
+import android.net.Uri
+import android.os.Handler
+import android.os.Looper
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.atomic.AtomicBoolean
+
+internal object TalkALaw {
+    fun encode(pcm: ByteArray): ByteArray {
+        require(pcm.size == 960)
+        return ByteArray(480) { i ->
+            var sample = ((pcm[i * 2].toInt() and 255) or (pcm[i * 2 + 1].toInt() shl 8)).toShort().toInt()
+            val mask = if (sample >= 0) 0xd5 else 0x55
+            if (sample < 0) sample = -sample - 1
+            var segment = 0
+            while (segment < 8 && sample > (0xff shl segment)) segment++
+            val value = if (segment >= 8) 0x7f else (segment shl 4) or
+                ((sample shr (if (segment < 2) 4 else segment + 3)) and 15)
+            (value xor mask).toByte()
+        }
+    }
+}
+
+/** Explicit start/end only. No recording starts when a popup is merely shown. */
+internal class DoorbellTalk(private val context: Context, private val endpoint: String,
+                            private val state: (String) -> Unit) {
+    private val active = AtomicBoolean(false)
+    private val worker = AtomicBoolean(false)
+    private val ui = Handler(Looper.getMainLooper())
+    @Volatile private var recorder: AudioRecord? = null
+    @Volatile private var upload: HttpURLConnection? = null
+    @Volatile private var download: HttpURLConnection? = null
+    @Volatile private var playback: AudioTrack? = null
+    @Volatile private var access: String? = null
+    @Volatile private var waitingForForeground = false
+    @Volatile private var foreground: DoorbellCallActivity? = null
+    private val focusLock = Any()
+    private var callFocus: AudioFocusRequest? = null
+    private val audioManager = context.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+    private fun requestCallFocus(): Boolean = synchronized(focusLock) {
+        if (!active.get()) return@synchronized false
+        val request = AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN_TRANSIENT_MAY_DUCK)
+            .setAudioAttributes(AudioAttributes.Builder()
+                .setUsage(AudioAttributes.USAGE_VOICE_COMMUNICATION)
+                .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH).build())
+            .setAcceptsDelayedFocusGain(false)
+            .setOnAudioFocusChangeListener({ change ->
+                if (change == AudioManager.AUDIOFOCUS_LOSS || change == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT) stop()
+            }, ui).build()
+        if (audioManager.requestAudioFocus(request) != AudioManager.AUDIOFOCUS_REQUEST_GRANTED) return@synchronized false
+        callFocus = request
+        android.util.Log.i("DoorbellTalk", "tv_duck_requested")
+        true
+    }
+    private fun releaseCallFocus() = synchronized(focusLock) {
+        val request = callFocus ?: return@synchronized
+        callFocus = null
+        runCatching { audioManager.abandonAudioFocusRequest(request) }
+        android.util.Log.i("DoorbellTalk", "tv_duck_released")
+    }
+    private val limit = Runnable { stop() }
+    private fun report(text: String) { ui.post { state(text) } }
+
+    fun toggle() { if (active.get()) stop() else start() }
+    fun stop() {
+        if (!worker.get()) return
+        active.set(false)
+        releaseCallFocus()
+        ui.removeCallbacks(limit)
+        if (waitingForForeground) {
+            waitingForForeground = false; worker.set(false)
+            ui.post { DoorbellCallActivity.cancelWaiting(this); report("通话") }
+            return
+        }
+        runCatching { recorder?.stop() }
+        upload?.disconnect()
+        download?.disconnect()
+        runCatching { playback?.stop() }
+        report("结束中…")
+    }
+    private fun connection(action: String, session: String? = null): HttpURLConnection {
+        val uri = Uri.parse(endpoint)
+        require(uri.scheme in listOf("http", "https"))
+        // Endpoint comes from the trusted HA popup and remains a numeric LAN address.
+        val host = uri.host ?: error("missing_host")
+        require(host.matches(Regex("(?:10\\.|192\\.168\\.|172\\.(?:1[6-9]|2[0-9]|3[01])\\.)[0-9.]+")))
+        require(uri.path == "/api/mi_cateye/talk")
+        val target = if (action == "authorize") uri else uri.buildUpon().clearQuery().appendQueryParameter("action", action).build()
+        return (URL(target.toString())
+            .openConnection() as HttpURLConnection).apply {
+            requestMethod = "POST"; connectTimeout = 4000; readTimeout = 6000
+            instanceFollowRedirects = false
+            access?.let { setRequestProperty("X-Talk-Access", it) }
+            if (session != null) setRequestProperty("X-Talk-Session", session)
+        }
+    }
+    private fun authorize() {
+        val grant = connection("authorize").apply { requestMethod = "GET" }
+        try {
+            check(grant.responseCode == 200)
+            access = JSONObject(grant.inputStream.bufferedReader().use { it.readText() }).getString("access")
+            check(access!!.matches(Regex("[a-f0-9]{64}")))
+        } finally { grant.disconnect() }
+    }
+    fun reply(preset: String) {
+        if (preset !in listOf("wait", "parcel", "later")) return
+        if (!worker.compareAndSet(false, true)) { report("请先结束当前通话"); return }
+        active.set(true); report("正在发送语音…")
+        Thread {
+            var sent = false
+            try {
+                authorize()
+                if (active.get()) {
+                    val wire = connection("reply").apply { readTimeout = 15000; setRequestProperty("X-Talk-Preset", preset) }
+                    upload = wire
+                    try { sent = wire.responseCode == 204 } finally { wire.disconnect() }
+                }
+            } catch (_: Exception) { }
+            finally {
+                val wasActive = active.getAndSet(false)
+                upload = null; access = null; worker.set(false)
+                if (wasActive) {
+                    report(if (sent) "语音已发送" else "语音回复失败，请重试")
+                    ui.postDelayed({ if (!worker.get()) report("通话") }, 2500)
+                }
+            }
+        }.start()
+    }
+    private fun start() {
+        if (context.checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+            report("麦克风未授权"); return
+        }
+        if (!worker.compareAndSet(false, true)) return
+        active.set(true)
+        report("连接中…")
+        val television = (context.getSystemService(Context.UI_MODE_SERVICE) as? android.app.UiModeManager)?.currentModeType == android.content.res.Configuration.UI_MODE_TYPE_TELEVISION
+        if (television) {
+            waitingForForeground = true
+            if (!DoorbellCallActivity.launch(context, this)) {
+                waitingForForeground = false; active.set(false); worker.set(false)
+                report("无法打开通话，请重试")
+            } else ui.postDelayed({ if (waitingForForeground) stop() }, 5000)
+        } else runCall()
+    }
+    internal fun foregroundReady(activity: DoorbellCallActivity) {
+        if (!waitingForForeground || !active.get()) { activity.finishFromOwner(); return }
+        waitingForForeground = false; foreground = activity
+        runCall()
+    }
+    private fun runCall() {
+        Thread {
+            var session: String? = null
+            var failed = false
+            var echo: AcousticEchoCanceler? = null
+            var receiveThread: Thread? = null
+            var stage = "authorize"
+            try {
+                authorize()
+                stage = "microphone"
+                val size = AudioRecord.getMinBufferSize(8000, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
+                check(size > 0)
+                val television = (context.getSystemService(Context.UI_MODE_SERVICE) as? android.app.UiModeManager)?.currentModeType == android.content.res.Configuration.UI_MODE_TYPE_TELEVISION
+                val captureSource = if (television) MediaRecorder.AudioSource.MIC else MediaRecorder.AudioSource.VOICE_COMMUNICATION
+                val audio = AudioRecord(captureSource, 8000,
+                    AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT, maxOf(size, 3840))
+                recorder = audio; check(audio.state == AudioRecord.STATE_INITIALIZED)
+                if (!television && AcousticEchoCanceler.isAvailable()) {
+                    echo = AcousticEchoCanceler.create(audio.audioSessionId)
+                    echo?.enabled = true
+                }
+                val begin = connection("begin")
+                stage = "begin"
+                try {
+                    check(begin.responseCode == 200) { "http_${begin.responseCode}" }
+                    val result = JSONObject(begin.inputStream.bufferedReader().use { it.readText() })
+                    session = result.getString("session")
+                    check(session!!.matches(Regex("[a-f0-9]{48}")))
+                    check(result.getInt("frame_bytes") == 480 && result.getInt("sample_rate") == 8000)
+                } finally { begin.disconnect() }
+                if (!active.get()) return@Thread
+                val ownedSession = session!!
+                receiveThread = Thread {
+                    var speaker: AudioTrack? = null
+                    try {
+                        if (!active.get()) return@Thread
+                        val receive = connection("listen", ownedSession); download = receive
+                        check(receive.responseCode == 200)
+                        if (!active.get()) return@Thread
+                        val min = AudioTrack.getMinBufferSize(8000, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT)
+                        check(min > 0)
+                        speaker = AudioTrack(AudioManager.STREAM_MUSIC, 8000, AudioFormat.CHANNEL_OUT_MONO,
+                            AudioFormat.ENCODING_PCM_16BIT, maxOf(min, 3840), AudioTrack.MODE_STREAM)
+                        playback = speaker; check(speaker.state == AudioTrack.STATE_INITIALIZED)
+                        if (active.get()) speaker.play()
+                        java.io.DataInputStream(receive.inputStream).use { input ->
+                            val pcm = ByteArray(960)
+                            while(active.get()) {
+                                input.readFully(pcm)
+                                if(active.get()) check(speaker.write(pcm, 0, pcm.size) > 0)
+                            }
+                        }
+                    } catch (_: Exception) { if(active.get()) stop() }
+                    finally {
+                        runCatching { speaker?.stop() }; runCatching { speaker?.release() }
+                        playback = null; download?.disconnect(); download = null
+                    }
+                }
+                val wire = connection("audio", session).apply {
+                    doOutput = true; setRequestProperty("Content-Type", "audio/pcma"); setChunkedStreamingMode(480)
+                }
+                upload = wire
+                wire.outputStream.use { out ->
+                    if (!active.get()) return@use
+                    audio.startRecording(); check(audio.recordingState == AudioRecord.RECORDSTATE_RECORDING)
+                    android.util.Log.i("DoorbellTalk", "mic_started source=$captureSource")
+                    if (!active.get()) return@use
+                    if (television) {
+                        stage = "audio_focus"
+                        check(requestCallFocus()) { "focus_denied" }
+                    }
+                    receiveThread?.start()
+                    report("挂断")
+                    ui.postDelayed(limit, 58000)
+                    val pcm = ByteArray(960)
+                    while (active.get()) {
+                        var count = 0
+                        while (count < pcm.size && active.get()) {
+                            val n = audio.read(pcm, count, pcm.size - count)
+                            check(n > 0); count += n
+                        }
+                        if (count == pcm.size && active.get()) { out.write(TalkALaw.encode(pcm)); out.flush() }
+                    }
+                }
+            } catch (error: Exception) {
+                failed = active.get()
+                android.util.Log.w("DoorbellTalk", "stage=$stage error=${error.javaClass.simpleName}")
+            }
+            finally {
+                active.set(false); ui.removeCallbacks(limit)
+                releaseCallFocus()
+                runCatching { recorder?.stop() }; runCatching { recorder?.release() }; recorder = null
+                android.util.Log.i("DoorbellTalk", "mic_released")
+                val ownerActivity = foreground; foreground = null
+                ui.post { ownerActivity?.finishFromOwner() }
+                echo?.release()
+                upload?.disconnect(); upload = null
+                download?.disconnect(); runCatching { playback?.stop() }
+                session?.let { id -> runCatching { connection("end", id).let { c -> try { c.responseCode } finally { c.disconnect() } } } }
+                access = null
+                runCatching { receiveThread?.join(8000) }
+                if (receiveThread?.isAlive != true) {
+                    worker.set(false)
+                    report(if (failed) "通话未连接，重试" else "通话")
+                } else report("结束中…")
+            }
+        }.start()
+    }
+}
