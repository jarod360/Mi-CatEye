+package nl.rogro82.pipup
+import org.junit.Assert.assertEquals
+import org.junit.Test
+class TalkALawTest {
+    @Test fun referenceSamplesAndNativeFrameSize() {
+        for ((sample, expected) in listOf(0 to 0xd5, -1 to 0x55, 32767 to 0xaa, -32768 to 0x2a)) {
+            val pcm = ByteArray(960)
+            for(i in 0 until 480) { pcm[i*2]=sample.toByte();pcm[i*2+1]=(sample shr 8).toByte() }
+            val result=TalkALaw.encode(pcm)
+            assertEquals(480,result.size)
+            result.forEach { assertEquals(expected,it.toInt() and 255) }
+        }
+    }
+}
