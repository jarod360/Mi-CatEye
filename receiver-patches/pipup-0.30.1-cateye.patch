+++ b/app/src/main/java/nl/rogro82/pipup/DoorbellButtonDrawable.kt
@@ -0,0 +1,58 @@
+package nl.rogro82.pipup
+
+import android.graphics.*
+import android.graphics.drawable.Drawable
+
+/** Locally drawn handset; no dependency on the system emoji font. */
+internal class DoorbellButtonDrawable : Drawable() {
+    var message = false
+    var focused = false
+        set(value) { field = value; invalidateSelf() }
+    var connected = false
+        set(value) { field = value; invalidateSelf() }
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    override fun draw(canvas: Canvas) {
+        val cx = bounds.exactCenterX(); val cy = bounds.exactCenterY()
+        val radius = minOf(bounds.width(), bounds.height()) / 2f
+        paint.style = Paint.Style.FILL
+        paint.color = if (message) Color.argb(128, 35, 115, 215)
+            else if (connected) Color.argb(128, 220, 45, 45) else Color.argb(128, 0, 170, 80)
+        canvas.drawCircle(cx, cy, radius - 1, paint)
+        if (focused) {
+            paint.style = Paint.Style.STROKE; paint.strokeWidth = 2f
+            paint.color = Color.argb(180, 240, 240, 240)
+            canvas.drawCircle(cx, cy, radius - 2, paint)
+        }
+        val path = Path()
+        if (message) {
+            path.moveTo(3f, 4f); path.lineTo(21f, 4f); path.lineTo(21f, 17f)
+            path.lineTo(10f, 17f); path.lineTo(5f, 21f); path.lineTo(5f, 17f)
+            path.lineTo(3f, 17f); path.close()
+        } else if (connected) {
+            path.moveTo(3f, 14f); path.cubicTo(7f, 6f, 17f, 6f, 21f, 14f)
+            path.lineTo(17f, 17f); path.lineTo(14f, 14f); path.lineTo(15f, 11f)
+            path.cubicTo(13f, 10f, 11f, 10f, 9f, 11f)
+            path.lineTo(10f, 14f); path.lineTo(7f, 17f); path.close()
+        } else {
+            path.moveTo(8f, 3f); path.lineTo(4f, 5f)
+            path.cubicTo(3f, 11f, 13f, 21f, 19f, 19f)
+            path.lineTo(21f, 15f); path.lineTo(16f, 12f); path.lineTo(13f, 15f)
+            path.cubicTo(10f, 13f, 8f, 11f, 7f, 8f)
+            path.lineTo(10f, 6f); path.close()
+        }
+        canvas.save(); canvas.translate(cx - 25f, cy - 25f); canvas.scale(50f / 24f, 50f / 24f)
+        paint.color = Color.argb(90, 190, 190, 190); paint.style = Paint.Style.STROKE
+        paint.strokeWidth = 1f; paint.strokeJoin = Paint.Join.ROUND
+        canvas.drawPath(path, paint)
+        paint.color = Color.WHITE; paint.style = Paint.Style.FILL; canvas.drawPath(path, paint)
+        if (message) {
+            paint.color = Color.argb(180, 0, 65, 130)
+            for (x in listOf(8f, 12f, 16f)) canvas.drawCircle(x, 10.5f, 0.8f, paint)
+        }
+        canvas.restore()
+    }
+    override fun setAlpha(alpha: Int) {}
+    override fun setColorFilter(filter: ColorFilter?) {}
+    @Deprecated("Android Drawable contract")
+    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+}
