new file mode 100644
index 0000000..6829274
--- /dev/null
+++ b/internal/streams/active_producer.go
@@ -0,0 +1,16 @@
+package streams
+
+import (
+ "errors"
+ "github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+// ActiveProducer never dials or starts a source. The caller must tolerate closure
+// when the last video viewer leaves; it must never reconnect a talk session.
+func(s *Stream) ActiveProducer()(core.Producer,error){
+ s.mu.Lock();defer s.mu.Unlock()
+ if len(s.producers)!=1{return nil,errors.New("single_active_producer_required")}
+ p:=s.producers[0];p.mu.Lock();defer p.mu.Unlock()
+ if p.state!=stateStart||p.conn==nil{return nil,errors.New("live_producer_unavailable")}
+ return p.conn,nil
+}
