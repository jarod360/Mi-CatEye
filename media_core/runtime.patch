@@ -0,0 +1,26 @@
+package cs2
+
+import (
+ "bytes"
+ "encoding/binary"
+ "net"
+ "testing"
+)
+
+type packetCapture struct {net.Conn; data []byte}
+func(c *packetCapture) Write(b []byte)(int,error){c.data=append([]byte(nil),b...);return len(b),nil}
+
+func TestWritePacketPreservesAudioPayload(t *testing.T){
+ socket:=&packetCapture{}
+ c:=&Conn{Conn:socket}
+ hdr:=bytes.Repeat([]byte{0x11},hdrSize)
+ payload:=bytes.Repeat([]byte{0x73,0x28},168)
+ for seq:=uint16(0);seq<2;seq++{
+  if err:=c.WritePacket(hdr,payload);err!=nil{t.Fatal(err)}
+  b:=socket.data
+  if len(b)!=12+len(hdr)+len(payload)||b[5]!=3{t.Fatal("invalid packet envelope")}
+  if binary.BigEndian.Uint16(b[6:])!=seq{t.Fatal("sequence not advanced")}
+  if !bytes.Equal(b[12:12+len(hdr)],hdr){t.Fatal("header changed")}
+  if !bytes.Equal(b[12+len(hdr):],payload){t.Fatal("audio replaced or truncated")}
+ }
+}
