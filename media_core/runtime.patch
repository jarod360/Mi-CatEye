diff --git a/pkg/xiaomi/miss/speaker_ack.go b/pkg/xiaomi/miss/speaker_ack.go
new file mode 100644
index 0000000..edb6d74
--- /dev/null
+++ b/pkg/xiaomi/miss/speaker_ack.go
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: MIT
+package miss
+import("encoding/binary";"encoding/json";"sort")
+func inspectSpeakerBody(data []byte)(bool,[]string,map[string]int){
+ // This Loock device answers 0x107 with a four-byte status, not JSON.
+ // Only exact zero is accepted; unknown lengths and nonzero codes fail closed.
+ if len(data)==4&&!json.Valid(data){
+  status:=binary.BigEndian.Uint32(data)
+  return status==0,[]string{"binary_status"},map[string]int{"status":int(status)}
+ }
+ var obj map[string]any
+ if json.Unmarshal(data,&obj)!=nil{return false,nil,nil}
+ keys:=[]string{};numbers:=map[string]int{};accepted:=false;rejected:=false
+ for k,v:=range obj{
+  keys=append(keys,k)
+  if k=="result" && v=="success"{accepted=true}
+  switch k{case "code","result","sample_rate","samplerate","codec_id","channels":if n,ok:=v.(float64);ok{numbers[k]=int(n);if k=="code"||k=="result"{if n==0{accepted=true}else{rejected=true}}}}
+ }
+ sort.Strings(keys);return accepted&&!rejected,keys,numbers
+}
