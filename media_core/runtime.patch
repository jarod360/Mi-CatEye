@@ -0,0 +1,21 @@
+package xiaomi
+import("bytes";"context";"encoding/json";"net/http/httptest";"strings";"testing")
+type testTalk struct{closed,frames int}
+func(s *testTalk) WriteFrame(b []byte)error{s.frames++;return nil}
+func(s *testTalk) Close()error{s.closed++;return nil}
+func TestTalkHTTPRequiresOwnerAndStopsOnEnd(t *testing.T){
+ writer:=&testTalk{};calls:=0;h:=&talkAPI{begin:func(context.Context)(talkWriter,error){calls++;return writer,nil}}
+ invoke:=func(action,id string,b []byte)*httptest.ResponseRecorder{r:=httptest.NewRequest("POST","/api/doorbell/talk?action="+action,bytes.NewReader(b));r.Header.Set("X-Talk-Session",id);r.Header.Set("Content-Type","audio/pcma");w:=httptest.NewRecorder();h.serve(w,r);return w}
+ begin:=invoke("begin","",nil);if begin.Code!=200{t.Fatal(begin.Code)};var result map[string]any;json.Unmarshal(begin.Body.Bytes(),&result);id:=result["session"].(string)
+ if invoke("begin","",nil).Code!=409||calls!=1{t.Fatal("parallel call accepted")}
+ if invoke("end",strings.Repeat("f",48),nil).Code!=404{t.Fatal("wrong owner accepted")}
+ if invoke("end",id,nil).Code!=204||writer.closed!=1{t.Fatal("end did not release")}
+ if invoke("audio",id,make([]byte,480)).Code!=404{t.Fatal("audio after end accepted")}
+}
+func TestTalkHTTPStreams480AndEndsOnTruncation(t *testing.T){
+ writer:=&testTalk{};h:=&talkAPI{begin:func(context.Context)(talkWriter,error){return writer,nil}}
+ w:=httptest.NewRecorder();h.serve(w,httptest.NewRequest("POST","/?action=begin",nil));var result map[string]any;json.Unmarshal(w.Body.Bytes(),&result)
+ request:=httptest.NewRequest("POST","/?action=audio",bytes.NewReader(make([]byte,481)));request.Header.Set("X-Talk-Session",result["session"].(string));request.Header.Set("Content-Type","audio/pcma")
+ w=httptest.NewRecorder();h.serve(w,request)
+ if w.Code!=400||writer.frames!=1||writer.closed!=1||h.active!=nil{t.Fatal("truncated uplink did not stop",w.Code,writer.frames,writer.closed)}
+}
