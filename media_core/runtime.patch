@@ -0,0 +1,29 @@
+package miss
+
+import (
+ "bytes"
+ "encoding/binary"
+ "errors"
+ "testing"
+ "github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+)
+
+type audioCapture struct {Conn; headers,payloads [][]byte; fail bool}
+func(c *audioCapture) WritePacket(h,p []byte)error{
+ if c.fail{return errors.New("test write failure")}
+ c.headers=append(c.headers,append([]byte(nil),h...));c.payloads=append(c.payloads,append([]byte(nil),p...));return nil
+}
+func TestAudioFrameSequenceAndEncryptedPayload(t *testing.T){
+ socket:=&audioCapture{}
+ c:=&Client{Conn:socket,key:make([]byte,32)}
+ audio:=bytes.Repeat([]byte{0x29,0x72},160)
+ for i:=uint32(0);i<3;i++{
+  if err:=c.WriteAudio(codecPCMA,audio);err!=nil{t.Fatal(err)}
+  h:=socket.headers[i];p:=socket.payloads[i]
+  if binary.LittleEndian.Uint32(h[8:])!=i{t.Fatal("repeated audio frame sequence")}
+  if binary.LittleEndian.Uint32(h[4:])!=codecPCMA||int(binary.LittleEndian.Uint32(h))!=len(p){t.Fatal("invalid audio metadata")}
+  decoded,err:=crypto.Decode(p,c.key);if err!=nil||!bytes.Equal(decoded,audio){t.Fatal("corrupt encrypted audio")}
+ }
+ socket.fail=true
+ if c.WriteAudio(codecPCMA,audio)==nil||c.audioSeq!=3{t.Fatal("failure was hidden or advanced sequence")}
+}
