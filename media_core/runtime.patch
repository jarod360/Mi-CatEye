+package tutk
+import("bytes";"encoding/binary";"testing")
+func TestLoockObservedNativeFrameEnvelope(t *testing.T){
+ s:=NewSession16(nil,make([]byte,8))
+ h:=make([]byte,32);binary.LittleEndian.PutUint32(h,488);binary.LittleEndian.PutUint32(h[4:],1027);binary.LittleEndian.PutUint32(h[8:],154)
+ media:=bytes.Repeat([]byte{0x73},488)
+ b:=s.SendFrameData(h,media)
+ if len(b)!=580{t.Fatal("does not match observed native UDP payload size")}
+ if binary.LittleEndian.Uint16(b[28:])!=769||binary.LittleEndian.Uint16(b[36:])!=488{t.Fatal("wrong TUTK audio envelope")}
