diff --git a/pkg/xiaomi/miss/sd_file_probe.go b/pkg/xiaomi/miss/sd_file_probe.go
new file mode 100644
index 0000000..8d16b68
--- /dev/null
+++ b/pkg/xiaomi/miss/sd_file_probe.go
@@ -0,0 +1,45 @@
+package miss
+
+import (
+ "encoding/binary"
+ "errors"
+ "io"
+ "os"
+ "strings"
+ "time"
+ "github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+)
+
+// ProbeSDFile retrieves one existing recording over the file channel. It never
+// starts a live stream or writes to the camera. The private caller deletes the
+// host-side sample after asking a decoder to validate it.
+func(c *Client) ProbeSDFile(item SDItem,path string)(map[string]any,error){
+ if item.Start<1262304000||item.Start>time.Now().Unix()-60{return nil,errors.New("file_time_rejected")}
+ channel,ok:=c.Conn.(interface{WriteChannel(byte,[]byte)error;ReadChannel(int)([]byte,error)})
+ if !ok{return nil,errors.New("file_transport_unsupported")}
+ _=c.SetDeadline(time.Now().Add(32*time.Second));defer c.SetDeadline(time.Time{})
+ request:=make([]byte,12);binary.LittleEndian.PutUint32(request,1);binary.LittleEndian.PutUint32(request[4:],4);binary.LittleEndian.PutUint32(request[8:],uint32(item.Start))
+ wire,err:=crypto.Encode(request,c.key);if err!=nil{return nil,errors.New("file_encode_failed")}
+ if err=channel.WriteChannel(1,wire);err!=nil{return nil,errors.New("file_request_failed")}
+ file,err:=os.OpenFile(path,os.O_CREATE|os.O_TRUNC|os.O_WRONLY,0600);if err!=nil{return nil,errors.New("file_sample_unavailable")};defer file.Close()
+ header:=make([]byte,0,12);want:=-1;total:=0;chunks:=0
+ for want<0||total<want{
+  chunk,e:=channel.ReadChannel(1);if e!=nil{
+   reason:="closed";message:=e.Error()
+   if strings.Contains(message,"pop buffer"){reason="queue_full"}else if strings.Contains(message,"timeout"){reason="timeout"}else if strings.Contains(message,"size limit"){reason="packet_size_limit"}
+   return map[string]any{"stage":"file_read_failed","chunks":chunks,"bytes":total,"expected_bytes":want,"reason":reason},nil
+  }
+  plain,e:=crypto.Decode(chunk,c.key);if e!=nil||len(plain)==0{return nil,errors.New("file_chunk_invalid")};chunks++
+  if want<0{
+   n:=min(12-len(header),len(plain));header=append(header,plain[:n]...);plain=plain[n:]
+   if len(header)<12{continue}
+   command:=binary.LittleEndian.Uint32(header);size:=binary.LittleEndian.Uint32(header[4:]);status:=binary.LittleEndian.Uint32(header[8:])
+   if command!=1||status!=0{return map[string]any{"stage":"file_header_rejected","command":command,"status":status},nil}
+   if size==0{return map[string]any{"stage":"file_not_found"},nil}
+   if size>16*1024*1024{return nil,errors.New("file_size_limit")};want=int(size)
+  }
+  if len(plain)>want-total{return nil,errors.New("file_extra_data")}
+  if n,e:=file.Write(plain);e!=nil||n!=len(plain){return nil,io.ErrShortWrite};total+=len(plain)
+ }
+ return map[string]any{"stage":"recording_file_received","bytes":total,"chunks":chunks,"file_confirmed":true},nil
+}
