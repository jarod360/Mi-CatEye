index 0000000..c28e8b9
--- /dev/null
+++ b/internal/xiaomi/cat_storage_test.go
@@ -0,0 +1,13 @@
+package xiaomi
+import("context";"testing";"time";"github.com/AlexxIT/go2rtc/pkg/core";"github.com/AlexxIT/go2rtc/pkg/xiaomi/miss")
+func TestCatLivePreemptsStorageWithoutParallelLease(t *testing.T){
+ g:=&storageAccess{};g.Lock();ctx,cancel:=context.WithCancel(context.Background());g.setCancel(cancel)
+ released:=make(chan struct{});go func(){<-ctx.Done();g.setCancel(nil);g.Unlock();close(released)}()
+ if !g.liveLease(true){t.Fatal("doorbell live did not preempt SD")};defer g.RUnlock()
+ select{case <-released:case <-time.After(time.Second):t.Fatal("SD did not release")}
+ if g.TryLock(){g.Unlock();t.Fatal("parallel SD writer acquired while live")}
+}
+func TestCatStorageWrapperRetainsTalkProducer(t *testing.T){
+ original:=&miss.Producer{};var p core.Producer=&storageProducer{Producer:original,release:func(){}}
+ if leased,ok:=p.(*storageProducer);ok{p=leased.Producer};camera,ok:=p.(*miss.Producer);if !ok||camera!=original{t.Fatal("talk cannot use existing cat connection")}
+}
diff --git a/internal/xiaomi/cateye_sd_recordings.go b/internal/xiaomi/cateye_sd_recordings.go
new file mode 100644
index 0000000..9ee30bc
--- /dev/null
+++ b/internal/xiaomi/cateye_sd_recordings.go
@@ -0,0 +1,80 @@
+// On-demand SD reads for the two individually validated camera models.
+package xiaomi
+import("context";"crypto/sha256";"encoding/hex";"encoding/json";"errors";"net/http";"net/url";"os";"os/exec";"path/filepath";"regexp";"sort";"strconv";"time";"github.com/AlexxIT/go2rtc/internal/streams";"github.com/AlexxIT/go2rtc/pkg/xiaomi/miss")
+func selectedSDSource(device string)(*url.URL,error){
+ if !regexp.MustCompile(`^[0-9]{1,24}$`).MatchString(device){return nil,errors.New("sd_not_supported")}
+ stream:=streams.Get("camera_"+device);doorbell:=stream==nil;if doorbell{stream=streams.Get("doorbell_live")};if stream==nil{return nil,errors.New("sd_not_supported")}
+ sources:=stream.Sources();if len(sources)!=1{return nil,errors.New("sd_not_supported")}
+ source,e:=url.Parse(sources[0]);if e!=nil||source.Scheme!="xiaomi"||source.User==nil||source.Query().Get("did")!=device||!sdModel(source.Query().Get("model"))||(!doorbell&&source.Query().Get("model")=="loock.cateye.v02"){return nil,errors.New("sd_not_supported")};return source,nil
+}
+func openSDReader(ctx context.Context,source *url.URL)(*miss.Client,func(),error){
+ gate:=storageGate(source);if !gate.TryLock(){return nil,nil,errors.New("storage_device_busy")}
+ ctx,cancel:=context.WithCancel(ctx);gate.setCancel(cancel)
+ release:=func(){cancel();gate.setCancel(nil);gate.Unlock()};copyURL:=*source
+ resolved,e:=getCameraURL(&copyURL);if e!=nil{release();return nil,nil,errors.New("sd_index_failed")}
+ if ctx.Err()!=nil{release();return nil,nil,errors.New("storage_device_busy")}
+ target,e:=url.Parse(resolved);if e!=nil||(target.Query().Get("vendor")!="cs2"&&target.Query().Get("vendor")!="tutk"){release();return nil,nil,errors.New("sd_not_supported")}
+ client,e:=miss.NewClient(resolved);if e!=nil{release();return nil,nil,errors.New("sd_index_failed")}
+ _=client.SetDeadline(time.Now().Add(38*time.Second))
+ cat:=source.Query().Get("model")=="loock.cateye.v02"
+ if channel,ok:=client.Conn.(interface{OpenSDChannel5()error});ok&&!cat{if e=channel.OpenSDChannel5();e!=nil{client.Close();release();return nil,nil,errors.New("sd_index_failed")}}
+ done:=make(chan struct{});go func(){select{case <-ctx.Done():client.Close();case <-done:}}()
+ if !cat{go func(){for{if _,_,e:=client.Conn.ReadCommand();e!=nil{return}}}()}
+ return client,func(){close(done);client.Close();release()},nil
+}
+func(s *recordingStore)listSD(w http.ResponseWriter,r *http.Request,start,end int64){
+ if start>=end||end-start>86400001{jsonReply(w,400,map[string]string{"error":"invalid_time_range"});return}
+ device:=r.URL.Query().Get("device");source,e:=selectedSDSource(device);if e!=nil{jsonReply(w,409,map[string]string{"error":"sd_not_supported"});return}
+ ctx,cancel:=context.WithTimeout(r.Context(),30*time.Second);defer cancel()
+ reader,closeReader,e:=openSDReader(ctx,source);if e!=nil{jsonReply(w,409,map[string]string{"error":e.Error()});return};defer closeReader()
+ var rows []miss.SDItem
+ if source.Query().Get("model")=="loock.cateye.v02"{
+  zone:=time.FixedZone("CST",8*3600);first,last:=time.UnixMilli(start).In(zone),time.UnixMilli(end-1).In(zone)
+  day:=time.Date(first.Year(),first.Month(),first.Day(),0,0,0,0,zone)
+  for count:=0;count<2;count++{var part []miss.SDItem;part,e=reader.ReadCatSDIndex(day);if e!=nil{break};rows=append(rows,part...);if day.Year()==last.Year()&&day.YearDay()==last.YearDay(){break};day=day.AddDate(0,0,1)}
+ }else{rows,e=reader.ReadSDIndex()}
+ if e!=nil{jsonReply(w,502,map[string]string{"error":"sd_index_failed"});return}
+ items:=make([]Recording,0)
+ for _,row:=range rows{
+  at:=row.Start*1000;if at<start||at>=end||row.Duration<1||row.Duration>3600{continue}
+  hash:=sha256.Sum256([]byte("sd:"+device+":"+strconv.FormatInt(row.Start,10)))
+  items=append(items,Recording{ID:hex.EncodeToString(hash[:16]),Source:"sd",Start:at,Duration:float64(row.Duration),Event:"local",SDDevice:device,SDStart:row.Start})
+ }
+ sort.Slice(items,func(i,j int)bool{return items[i].Start>items[j].Start});if len(items)>5000{items=items[:5000]}
+ s.mu.Lock();if len(s.records)>12000{s.records=map[string]Recording{}};for _,item:=range items{s.records[item.ID]=item};s.mu.Unlock()
+ jsonReply(w,200,map[string]any{"items":items,"source":"sd","sd_supported":true})
+}
+func(s *recordingStore)downloadSD(ctx context.Context,item Recording)error{
+ if !s.prepareMu.TryLock(){return errors.New("storage_device_busy")};defer s.prepareMu.Unlock()
+ source,e:=selectedSDSource(item.SDDevice);if e!=nil{return e}
+ directory:=filepath.Join(s.directory,"sd");if e=os.MkdirAll(directory,0700);e!=nil{return errors.New("sd_file_failed")}
+ path:=filepath.Join(directory,item.ID+".mp4")
+ if info,e:=os.Lstat(path);e==nil&&info.Mode().IsRegular()&&info.Size()>1024&&time.Since(info.ModTime())<10*time.Minute{return nil}
+ work,e:=os.MkdirTemp(directory,".prepare-");if e!=nil{return errors.New("sd_file_failed")};defer os.RemoveAll(work)
+ raw:=filepath.Join(work,"original.mp4");output:=filepath.Join(work,"clip.mp4")
+ reader,closeReader,e:=openSDReader(ctx,source);if e!=nil{return e}
+ if source.Query().Get("model")=="loock.cateye.v02"{
+  zone:=time.FixedZone("CST",8*3600);var rows []miss.SDItem;rows,e=reader.ReadCatSDIndex(time.Unix(item.SDStart,0).In(zone));found:=false
+  for _,row:=range rows{if row.Start==item.SDStart&&row.Duration==int(item.Duration){found=true;break}}
+  if e==nil&&!found{e=errors.New("sd_file_failed")};if e==nil{e=reader.ReadCatSDFile(miss.SDItem{Start:item.SDStart,Duration:int(item.Duration)},zone,raw)}
+ }else{var report map[string]any;report,e=reader.ProbeSDFile(miss.SDItem{Start:item.SDStart,Duration:int(item.Duration)},raw);if e==nil&&report["stage"]!="recording_file_received"{e=errors.New("sd_file_failed")}}
+ closeReader();if e!=nil{if source.Query().Get("model")=="loock.cateye.v02"{if b,err:=os.ReadFile(raw+".failure.json");err==nil&&len(b)<4096&&json.Valid(b){_ =os.WriteFile(filepath.Join(s.directory,"cat-read-failure.json"),b,0600)}};return errors.New("sd_file_failed")}
+ if source.Query().Get("model")=="loock.cateye.v02"{_ =os.Remove(filepath.Join(s.directory,"cat-read-failure.json"))}
+ // Inspect only codec names; all filenames, frames and diagnostics remain private.
+ probe:=exec.CommandContext(ctx,"ffprobe","-v","error","-show_entries","stream=codec_type,codec_name","-of","json",raw)
+ encoded,e:=probe.Output();if e!=nil||len(encoded)>16384{return errors.New("sd_conversion_failed")}
+ var meta struct{Streams []struct{Type string `json:"codec_type"`;Codec string `json:"codec_name"`} `json:"streams"`};if json.Unmarshal(encoded,&meta)!=nil{return errors.New("sd_conversion_failed")}
+ video:="";for _,stream:=range meta.Streams{if stream.Type=="video"{video=stream.Codec;break}}
+ if video!="hevc"&&video!="h264"{return errors.New("sd_conversion_failed")}
+ args:=[]string{"-nostdin","-hide_banner","-loglevel","error","-y","-i",raw,"-map","0:v:0","-map","0:a?","-c:v","copy","-c:a","aac","-b:a","32k","-movflags","+faststart"};if video=="hevc"{args=append(args,"-tag:v","hvc1")};args=append(args,output)
+ if e=exec.CommandContext(ctx,"ffmpeg",args...).Run();e!=nil{return errors.New("sd_conversion_failed")}
+ info,e:=os.Stat(output);if e!=nil||info.Size()<1024||info.Size()>32*1024*1024{return errors.New("sd_file_failed")}
+ if os.Chmod(output,0600)!=nil||os.Rename(output,path)!=nil{return errors.New("sd_file_failed")}
+ pruneSD(directory,item.ID);return nil
+}
+func pruneSD(directory,keep string){
+ entries,_:=os.ReadDir(directory);type cached struct{name string;bytes int64;at time.Time};files:=[]cached{};var total int64
+ for _,entry:=range entries{if entry.IsDir()||!validRecordingID(entry.Name()[:max(0,len(entry.Name())-4)])||filepath.Ext(entry.Name())!=".mp4"{continue};info,e:=entry.Info();if e==nil&&info.Mode().IsRegular(){files=append(files,cached{entry.Name(),info.Size(),info.ModTime()});total+=info.Size()}}
+ sort.Slice(files,func(i,j int)bool{return files[i].at.Before(files[j].at)});count:=len(files)
+ for _,file:=range files{if file.name==keep+".mp4"{continue};if count>3||total>32*1024*1024||time.Since(file.at)>10*time.Minute{if os.Remove(filepath.Join(directory,file.name))==nil{count--;total-=file.bytes}}}
+}
