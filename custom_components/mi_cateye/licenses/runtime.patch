+++ b/internal/streams/active_producer.go
@@ -0,0 +1,16 @@
+package streams
+
+import (
+ "errors"
+ "github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+// ActiveProducer never dials or starts a source. The caller must tolerate closure
+// when the last video viewer leaves; it must never reconnect a talk session.
+func(s *Stream) ActiveProducer()(core.Producer,error){
+ s.mu.Lock();defer s.mu.Unlock()
+ if len(s.producers)!=1{return nil,errors.New("single_active_producer_required")}
+ p:=s.producers[0];p.mu.Lock();defer p.mu.Unlock()
+ if p.state!=stateStart||p.conn==nil{return nil,errors.New("live_producer_unavailable")}
+ return p.conn,nil
+}
diff --git a/internal/streams/active_producer_test.go b/internal/streams/active_producer_test.go
new file mode 100644
index 0000000..0f781c2
--- /dev/null
+++ b/internal/streams/active_producer_test.go
@@ -0,0 +1,15 @@
+package streams
+
+import("testing";"github.com/AlexxIT/go2rtc/pkg/core")
+type existingOnly struct{core.Producer}
+func TestActiveProducerNeverDialsAndReturnsSameConnection(t *testing.T){
+ s:=NewStream("not-a-valid-dial-source")
+ if _,e:=s.ActiveProducer();e==nil{t.Fatal("inactive source accepted")}
+ original:=&existingOnly{}
+ s.producers[0].conn=original;s.producers[0].state=stateStart
+ for i:=0;i<2;i++{p,e:=s.ActiveProducer();if e!=nil||p!=original{t.Fatal("connection replaced",e)}}
+ s.producers[0].state=stateNone
+ if _,e:=s.ActiveProducer();e==nil{t.Fatal("closed source accepted")}
+ s.producers=append(s.producers,&Producer{conn:original,state:stateStart})
+ if _,e:=s.ActiveProducer();e==nil{t.Fatal("ambiguous sources accepted")}
+}
diff --git a/internal/xiaomi/camera_move_lan.go b/internal/xiaomi/camera_move_lan.go
new file mode 100644
index 0000000..d1377e4
--- /dev/null
+++ b/internal/xiaomi/camera_move_lan.go
@@ -0,0 +1,101 @@
+package xiaomi
+
+import (
+	"bytes"
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/md5"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"time"
+)
+
+// localCameraMove sends exactly one authenticated miIO motor command. A missing
+// acknowledgement is ambiguous and must never cause a second move.
+func localCameraMove(ctx context.Context, host string, token []byte, operation int) error {
+	ip := net.ParseIP(host)
+	if ip == nil || ip.To4() == nil || !ip.IsPrivate() || len(token) != 16 {
+		return errors.New("camera_lan_unavailable")
+	}
+	conn, err := net.DialUDP("udp4", nil, &net.UDPAddr{IP: ip, Port: 54321})
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	stop := context.AfterFunc(ctx, func() { _ = conn.Close() })
+	defer stop()
+	if err = conn.SetDeadline(time.Now().Add(2500 * time.Millisecond)); err != nil {
+		return err
+	}
+	hello := bytes.Repeat([]byte{255}, 32)
+	copy(hello, []byte{0x21, 0x31, 0, 32})
+	if _, err = conn.Write(hello); err != nil {
+		return err
+	}
+	buf := make([]byte, 4096)
+	n, err := conn.Read(buf)
+	if err != nil || n != 32 || buf[0] != 0x21 || buf[1] != 0x31 {
+		return errors.New("camera_lan_hello_failed")
+	}
+	id := int(time.Now().UnixMilli() % 1000000)
+	body := []byte(fmt.Sprintf(`{"id":%d,"method":"set_motor","params":{"operation":%d}}`, id, operation))
+	padding := aes.BlockSize - len(body)%aes.BlockSize
+	body = append(body, bytes.Repeat([]byte{byte(padding)}, padding)...)
+	key := md5.Sum(token)
+	iv := md5.Sum(append(key[:], token...))
+	block, _ := aes.NewCipher(key[:])
+	cipher.NewCBCEncrypter(block, iv[:]).CryptBlocks(body, body)
+	packet := make([]byte, 32+len(body))
+	copy(packet[:16], buf[:16])
+	binary.BigEndian.PutUint32(packet[4:8], 0)
+	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+	copy(packet[16:32], token)
+	copy(packet[32:], body)
+	checksum := md5.Sum(packet)
+	copy(packet[16:32], checksum[:])
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	if err = conn.SetDeadline(time.Now().Add(2500 * time.Millisecond)); err != nil {
+		return err
+	}
+	if _, err = conn.Write(packet); err != nil {
+		return err
+	}
+	for {
+		n, err = conn.Read(buf)
+		if err != nil {
+			return err
+		}
+		if n <= 32 || (n-32)%aes.BlockSize != 0 || buf[0] != 0x21 || buf[1] != 0x31 {
+			continue
+		}
+		signature := [16]byte(buf[16:32])
+		copy(buf[16:32], token)
+		if signature != md5.Sum(buf[:n]) {
+			continue
+		}
+		payload := buf[32:n]
+		cipher.NewCBCDecrypter(block, iv[:]).CryptBlocks(payload, payload)
+		pad := int(payload[len(payload)-1])
+		if pad < 1 || pad > aes.BlockSize || !bytes.Equal(payload[len(payload)-pad:], bytes.Repeat([]byte{byte(pad)}, pad)) {
+			continue
+		}
+		var reply struct {
+			ID     int
+			Result json.RawMessage
+			Error  json.RawMessage
+		}
+		if json.Unmarshal(bytes.TrimRight(payload[:len(payload)-pad], "\x00"), &reply) != nil || reply.ID != id {
+			continue
+		}
+		if len(reply.Result) == 0 || (len(reply.Error) != 0 && string(reply.Error) != "null") {
+			return errors.New("camera_lan_move_rejected")
+		}
+		return nil
+	}
+}
diff --git a/internal/xiaomi/camera_state.go b/internal/xiaomi/camera_state.go
new file mode 100644
index 0000000..ec38847
--- /dev/null
+++ b/internal/xiaomi/camera_state.go
@@ -0,0 +1,133 @@
+// Fixed selected-camera status and explicit privacy control; no video session.
+package xiaomi
+
+import (
+ "encoding/json"
+ "errors"
+ "encoding/hex"
+ "net/http"
+ "net/url"
+ "sync"
+ "time"
+
+ "github.com/AlexxIT/go2rtc/internal/streams"
+)
+
+type cameraState struct { Online *bool `json:"online"`; Enabled *bool `json:"enabled"` }
+var cameraCloudRequest = cloudUserRequest
+var cameraControlLocks sync.Map
+
+func readCameraState(source *url.URL)(cameraState,error){
+ state, _, err := readCameraDetails(source)
+ return state, err
+}
+
+func readCameraDetails(source *url.URL)(cameraState,[]byte,error){
+ result:=cameraState{};did:=source.Query().Get("did")
+ params,_:=json.Marshal(map[string]any{"dids":[]string{did},"limit":20})
+ raw,e:=cameraCloudRequest(source.User,"/v2/home/device_list_page",string(params));if e!=nil{return result,nil,errors.New("camera_status_failed")}
+ var devices struct{List []struct{Did string `json:"did"`;Online *bool `json:"isOnline"`;Token string `json:"token"`} `json:"list"`}
+ if json.Unmarshal(raw,&devices)!=nil{return result,nil,errors.New("camera_status_failed")}
+ var token []byte
+ for _,device:=range devices.List{if device.Did==did{result.Online=device.Online;token,_=hex.DecodeString(device.Token);break}}
+ params,_=json.Marshal(map[string]any{"datasource":1,"params":[]map[string]any{{"did":did,"siid":2,"piid":1}}})
+ raw,e=cameraCloudRequest(source.User,"/miotspec/prop/get",string(params));if e!=nil{return result,token,nil}
+ var props []struct{Did string `json:"did"`;Siid int `json:"siid"`;Piid int `json:"piid"`;Code int `json:"code"`;Value *bool `json:"value"`}
+ if json.Unmarshal(raw,&props)!=nil{return result,token,nil}
+ for _,p:=range props{if p.Did==did&&p.Siid==2&&p.Piid==1&&p.Code==0{result.Enabled=p.Value}}
+ return result,token,nil
+}
+
+func writeCameraEnabled(source *url.URL,enabled bool)error{
+ did:=source.Query().Get("did");params,_:=json.Marshal(map[string]any{"params":[]map[string]any{{"did":did,"siid":2,"piid":1,"value":enabled}}})
+ raw,e:=cameraCloudRequest(source.User,"/miotspec/prop/set",string(params));if e!=nil{return errors.New("camera_control_failed")}
+ var replies []struct{Did string `json:"did"`;Siid int `json:"siid"`;Piid int `json:"piid"`;Code int `json:"code"`}
+ if json.Unmarshal(raw,&replies)!=nil||len(replies)!=1{return errors.New("camera_control_failed")};r:=replies[0]
+ if r.Did!=did||r.Siid!=2||r.Piid!=1||r.Code!=0{return errors.New("camera_control_failed")};return nil
+}
+
+func(s *recordingStore)cameraControl(w http.ResponseWriter,r *http.Request){
+ if r.Method!="GET"&&r.Method!="POST"{w.WriteHeader(http.StatusMethodNotAllowed);return}
+ source,e:=selectedSDSource(r.URL.Query().Get("device"));if e!=nil||source.Query().Get("model")=="loock.cateye.v02"{jsonReply(w,400,map[string]string{"error":"camera_not_selected"});return}
+ item,_:=cameraControlLocks.LoadOrStore(source.Query().Get("did"),&sync.Mutex{});lock:=item.(*sync.Mutex)
+ if !lock.TryLock(){jsonReply(w,409,map[string]string{"error":"camera_control_busy"});return};defer lock.Unlock()
+ if r.Method=="POST"{
+  var body struct{Enabled *bool `json:"enabled"`;Confirmed bool `json:"confirmed"`};decoder:=json.NewDecoder(http.MaxBytesReader(w,r.Body,128));decoder.DisallowUnknownFields()
+  if decoder.Decode(&body)!=nil||body.Enabled==nil||!body.Confirmed{jsonReply(w,400,map[string]string{"error":"camera_confirmation_required"});return}
+  if e=writeCameraEnabled(source,*body.Enabled);e!=nil{jsonReply(w,502,map[string]string{"error":"camera_control_failed"});return}
+ }
+ state,e:=readCameraState(source);if e!=nil{jsonReply(w,502,map[string]string{"error":"camera_status_failed"});return};jsonReply(w,200,state)
+}
+
+var cameraLastMove sync.Map
+
+func (s *recordingStore) cameraMove(w http.ResponseWriter, r *http.Request) {
+ if r.Method != http.MethodPost {
+  w.WriteHeader(http.StatusMethodNotAllowed)
+  return
+ }
+ var body struct { Direction string `json:"direction"` }
+ decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, 96))
+ decoder.DisallowUnknownFields()
+ if decoder.Decode(&body) != nil {
+  jsonReply(w, 400, map[string]string{"error": "invalid_direction"})
+  return
+ }
+ operation, ok := map[string]int{"left": 1, "right": 2, "up": 3, "down": 4}[body.Direction]
+ if !ok {
+  jsonReply(w, 400, map[string]string{"error": "invalid_direction"})
+  return
+ }
+ device := r.URL.Query().Get("device")
+ source, err := selectedSDSource(device)
+ if err != nil || !cameraMoveModel(source.Query().Get("model")) {
+  jsonReply(w, 400, map[string]string{"error": "camera_not_selected"})
+  return
+ }
+ item, _ := cameraControlLocks.LoadOrStore(device, &sync.Mutex{})
+ lock := item.(*sync.Mutex)
+ if !lock.TryLock() {
+  jsonReply(w, 409, map[string]string{"error": "camera_control_busy"})
+  return
+ }
+ defer lock.Unlock()
+ if last, ok := cameraLastMove.Load(device); ok && time.Since(last.(time.Time)) < 400*time.Millisecond {
+  jsonReply(w, 429, map[string]string{"error": "camera_move_rate"})
+  return
+ }
+ stream := streams.Get("camera_"+device)
+ if stream == nil {
+  jsonReply(w, 409, map[string]string{"error": "camera_not_playing"})
+  return
+ }
+ if _, err = stream.ActiveProducer(); err != nil {
+  jsonReply(w, 409, map[string]string{"error": "camera_not_playing"})
+  return
+ }
+ state, token, err := readCameraDetails(source)
+ if err != nil || state.Online == nil || !*state.Online || state.Enabled == nil || !*state.Enabled {
+  jsonReply(w, 409, map[string]string{"error": "camera_unavailable"})
+  return
+ }
+ if _, err = stream.ActiveProducer(); err != nil || r.Context().Err() != nil {
+  jsonReply(w, 409, map[string]string{"error": "camera_not_playing"})
+  return
+ }
+ if len(token) != 16 {
+  jsonReply(w, 409, map[string]string{"error": "camera_lan_token_unavailable"})
+  return
+ }
+ if source.Query().Get("model") == "chuangmi.camera.ipc021" {
+  operation = ((operation - 1) ^ 1) + 1
+ }
+ cameraLastMove.Store(device, time.Now())
+ if err = localCameraMove(r.Context(), source.Hostname(), token, operation); err != nil {
+  jsonReply(w, 502, map[string]string{"error": "camera_move_unconfirmed"})
+  return
+ }
+ jsonReply(w, 200, map[string]bool{"sent": true})
+}
+
+func cameraMoveModel(model string) bool {
+ return model == "chuangmi.camera.ipc009" || model == "chuangmi.camera.ipc021"
+}
diff --git a/internal/xiaomi/camera_state_test.go b/internal/xiaomi/camera_state_test.go
