+++ b/internal/xiaomi/camera_state_test.go
@@ -0,0 +1,18 @@
+package xiaomi
+import("encoding/json";"net/url";"testing")
+func TestCameraStatusDoesNotTreatPrivacyAsOffline(t *testing.T){
+ old:=cameraCloudRequest;defer func(){cameraCloudRequest=old}();calls:=0
+ cameraCloudRequest=func(_ *url.Userinfo,path,params string)([]byte,error){calls++;if path=="/v2/home/device_list_page"{return []byte(`{"list":[{"did":"123","isOnline":true,"token":"secret"}]}`),nil};return []byte(`[{"did":"123","siid":2,"piid":1,"code":0,"value":false}]`),nil}
+ src,_:=url.Parse("xiaomi://user:cn@host?did=123");state,e:=readCameraState(src);if e!=nil||state.Online==nil||!*state.Online||state.Enabled==nil||*state.Enabled||calls!=2{t.Fatal(state,e,calls)}
+ raw,_:=json.Marshal(state);if string(raw)!=`{"online":true,"enabled":false}`{t.Fatal(string(raw))}
+}
+func TestCameraWriteRejectsMismatchedAcknowledgement(t *testing.T){
+ old:=cameraCloudRequest;defer func(){cameraCloudRequest=old}();src,_:=url.Parse("xiaomi://user:cn@host?did=123")
+ cameraCloudRequest=func(_ *url.Userinfo,path,params string)([]byte,error){if path!="/miotspec/prop/set"{t.Fatal(path)};return []byte(`[{"did":"456","siid":2,"piid":1,"code":0}]`),nil}
+ if writeCameraEnabled(src,true)==nil{t.Fatal("mismatched device accepted")}
+}
+func TestCameraUnknownStatusStaysUnknown(t *testing.T){
+ old:=cameraCloudRequest;defer func(){cameraCloudRequest=old}();src,_:=url.Parse("xiaomi://user:cn@host?did=123")
+ cameraCloudRequest=func(_ *url.Userinfo,path,params string)([]byte,error){if path=="/v2/home/device_list_page"{return []byte(`{"list":[]}`),nil};return []byte(`[{"did":"123","siid":2,"piid":1,"code":-1}]`),nil}
+ state,e:=readCameraState(src);if e!=nil||state.Online!=nil||state.Enabled!=nil{t.Fatal(state,e)}
+}
diff --git a/internal/xiaomi/cat_storage_test.go b/internal/xiaomi/cat_storage_test.go
