+package tutk
+import("bytes";"encoding/binary";"net";"testing")
+func testSDConn(t *testing.T)*Conn{
+ t.Helper();peer,e:=net.ListenUDP("udp",&net.UDPAddr{IP:net.IPv4(127,0,0,1)});if e!=nil{t.Fatal(e)};t.Cleanup(func(){peer.Close()})
+ udp,e:=net.ListenUDP("udp",&net.UDPAddr{IP:net.IPv4(127,0,0,1)});if e!=nil{t.Fatal(e)}
+ c:=&Conn{UDPConn:udp,addr:peer.LocalAddr().(*net.UDPAddr)};c.session=NewSession16(c,make([]byte,8))
+ c.sdRDT=&sdRDTState{c:c,ready:make(chan struct{}),done:make(chan struct{}),chunks:make(chan []byte,256),acks:make(chan uint64,16),future:map[uint64][]byte{}}
+ t.Cleanup(func(){c.Close()});return c
+}
+func testSDFrame(packet []byte)[]byte{b:=make([]byte,28+len(packet));b[8]=8;b[14]=5;copy(b[28:],packet);return b}
+func TestRDTProbeOrdersAndDeduplicatesData(t *testing.T){
+ c:=testSDConn(t);body:=[]byte("abcdefgh");data:=binary.BigEndian.AppendUint32(nil,8);data=append(data,body...)
+ second:=testSDFrame(rdtProbePacket(2,1,1,data[6:]));first:=testSDFrame(rdtProbePacket(2,0,1,data[:6]))
+ c.receiveSDFrame(second);c.receiveSDFrame(first);c.receiveSDFrame(first)
+ got,e:=c.ReadChannel(1);if e!=nil||!bytes.Equal(got,body)||len(c.sdRDT.chunks)!=0{t.Fatal("ordered stream changed or duplicate exposed",e)}
+}
+func TestRDTProbeRejectsMalformedHeaderAndLargeGap(t *testing.T){
+ for _,test:=range []string{"length","gap"}{t.Run(test,func(t *testing.T){
+  c:=testSDConn(t);packet:=rdtProbePacket(2,0,1,[]byte{1});if test=="length"{packet[6]=2}else{binary.LittleEndian.PutUint64(packet[8:],100)}
+  c.receiveSDFrame(testSDFrame(packet));select{case <-c.sdRDT.done:default:t.Fatal("invalid frame did not close owned probe")}
+ })}
+}
+func TestRDTProbeOnlyInterceptsItsFixedChannel(t *testing.T){
+ c:=testSDConn(t);frame:=testSDFrame(rdtProbePacket(1,0,1,nil));frame[14]=1
+ if c.receiveSDFrame(frame){t.Fatal("AV/control channel intercepted")}
+ if _,e:=c.ReadChannel(2);e==nil{t.Fatal("unexpected channel accepted")}
+}
