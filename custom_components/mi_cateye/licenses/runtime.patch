+ frames,done,e:=talk.PCM();if e!=nil{t.Fatal(e)}
+ track,_:=p.GetTrack(audio,audio.Codecs[0]);track.WriteRTP(&core.Packet{Payload:[]byte{0xd5,0x55}})
+ select{case b:=<-frames:if len(b)!=4||b[0]!=8||b[2]!=248||b[3]!=255{t.Fatal("wrong PCM",b)};case <-time.After(time.Second):t.Fatal("no downlink audio")}
+ talk.Close();select{case <-done:default:t.Fatal("listen not stopped")}
+ same,_:=p.GetTrack(video,video.Codecs[0]);if same!=videoTrack{t.Fatal("video track replaced")}
+}
diff --git a/pkg/xiaomi/miss/talk_session.go b/pkg/xiaomi/miss/talk_session.go
new file mode 100644
index 0000000..5d8f8c5
--- /dev/null
+++ b/pkg/xiaomi/miss/talk_session.go
@@ -0,0 +1,102 @@
+package miss
+
+import (
+ "context"
+ "encoding/binary"
+ "errors"
+ "sync"
+ "time"
+ "github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+ "github.com/AlexxIT/go2rtc/pkg/core"
+ "github.com/AlexxIT/go2rtc/pkg/pcm"
+)
+
+// TalkSession is one explicit start/end call on the existing video connection.
+// It does not dial, start media, change volume, or acquire a microphone.
+type TalkSession struct{
+ p *Producer
+ ctx context.Context
+ cancel context.CancelFunc
+ mu sync.Mutex
+ closed bool
+ done chan struct{}
+ audioSender *core.Sender
+ audio chan []byte
+}
+
+func(p *Producer) readControls(){
+ for{
+  cmd,data,e:=p.client.Conn.ReadCommand();if e!=nil{return}
+  if cmd==cmdEncoded{
+   if len(data)<8{continue};data,e=crypto.Decode(data,p.client.key);if e!=nil||len(data)<4{continue}
+   cmd=binary.BigEndian.Uint32(data);data=data[4:]
+  }
+  p.controlMu.Lock();ch:=p.controlPending[cmd];if ch!=nil{select{case ch<-data:default:}};p.controlMu.Unlock()
+ }
+}
+
+func(p *Producer) BeginTalk(parent context.Context)(*TalkSession,error){
+ if p.client.model!=ModelLoockV2{return nil,errors.New("talk_model_unsupported")}
+ if !p.talkMu.TryLock(){return nil,errors.New("talk_already_active")}
+ ctx,cancel:=context.WithTimeout(parent,60*time.Second)
+ ch:=make(chan []byte,1)
+ p.controlMu.Lock();if p.controlPending==nil{p.controlPending=map[uint32]chan []byte{}};p.controlPending[cmdSpeakerStartRes]=ch;p.controlMu.Unlock()
+ defer func(){p.controlMu.Lock();if p.controlPending[cmdSpeakerStartRes]==ch{delete(p.controlPending,cmdSpeakerStartRes)};p.controlMu.Unlock()}()
+ p.controlOnce.Do(func(){go p.readControls()})
+ fail:=func(e error)(*TalkSession,error){cancel();p.client.WriteCommand(binary.BigEndian.AppendUint32(nil,cmdSpeakerStop));p.talkMu.Unlock();return nil,e}
+ if e:=ctx.Err();e!=nil{cancel();p.talkMu.Unlock();return nil,e}
+ if e:=p.client.StartSpeaker();e!=nil{return fail(e)}
+ timer:=time.NewTimer(4*time.Second);defer timer.Stop()
+ select{
+ case <-ctx.Done():return fail(ctx.Err())
+ case <-timer.C:return fail(errors.New("talk_start_timeout"))
+ case data:=<-ch:
+  ok,_,_:=inspectSpeakerBody(data);if !ok{return fail(errors.New("talk_start_rejected"))}
+ }
+ s:=&TalkSession{p:p,ctx:ctx,cancel:cancel,done:make(chan struct{})}
+ go func(){<-ctx.Done();s.Close()}()
+ return s,nil
+}
+
+// WriteFrame accepts exactly the 480-byte PCMA frame observed on this device.
+// The audio transport must pace frames at 60 ms and must not buffer a backlog.
+func(s *TalkSession) WriteFrame(data []byte)error{
+ s.mu.Lock();defer s.mu.Unlock()
+ if s.closed{return errors.New("talk_ended")}
+ if e:=s.ctx.Err();e!=nil{return e}
+ if len(data)!=480{return errors.New("talk_frame_size_rejected")}
+ return s.p.client.WriteAudio(codecPCMA,data)
+}
+
+func(s *TalkSession) Close()error{
+ s.mu.Lock();defer s.mu.Unlock()
+ if s.closed{return nil}
+ s.closed=true;s.cancel()
+ close(s.done)
+ if s.audioSender!=nil{s.audioSender.Close()}
+ defer s.p.talkMu.Unlock()
+ return s.p.client.WriteCommand(binary.BigEndian.AppendUint32(nil,cmdSpeakerStop))
+}
+
+// PCM subscribes to the same connection's incoming track; it never dials.
+func(s *TalkSession) PCM()(<-chan []byte,<-chan struct{},error){
+ s.mu.Lock();defer s.mu.Unlock()
+ if s.closed{return nil,nil,errors.New("talk_ended")}
+ if s.audio!=nil{return s.audio,s.done,nil}
+ for _,media:=range s.p.GetMedias(){
+  if media.Kind!=core.KindAudio||media.Direction!=core.DirectionRecvonly{continue}
+  for _,codec:=range media.Codecs{
+   if codec.Name!=core.CodecPCMA||codec.ClockRate!=8000{continue}
+   track,e:=s.p.GetTrack(media,codec);if e!=nil{return nil,nil,e}
+   queue:=make(chan []byte,8);sender:=core.NewSender(media,codec)
+   sender.Handler=func(packet *core.Packet){
+    b:=make([]byte,len(packet.Payload)*2)
+    for i,v:=range packet.Payload{binary.LittleEndian.PutUint16(b[i*2:],uint16(pcm.PCMAtoPCM(v)))}
+    select{case <-s.done:return;default:}
+    select{case queue<-b:default:select{case <-queue:default:};select{case queue<-b:default:}}
+   }
+   sender.HandleRTP(track);s.audio=queue;s.audioSender=sender;return queue,s.done,nil
+  }
+ }
+ return nil,nil,errors.New("talk_receive_codec_unsupported")
+}
diff --git a/pkg/xiaomi/miss/talk_session_test.go b/pkg/xiaomi/miss/talk_session_test.go
new file mode 100644
index 0000000..dd48f76
--- /dev/null
+++ b/pkg/xiaomi/miss/talk_session_test.go
@@ -0,0 +1,68 @@
+package miss
+import("context";"errors";"encoding/binary";"io";"sync";"testing";"time";"github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto")
+type talkTestWire struct{Conn;key []byte;commands chan []byte;mu sync.Mutex;starts,stops,frames int}
+func(w *talkTestWire) ReadCommand()(uint32,[]byte,error){b,ok:=<-w.commands;if !ok{return 0,nil,io.EOF};return cmdEncoded,b,nil}
+func(w *talkTestWire) WriteCommand(cmd uint32,b []byte)error{
+ plain,e:=crypto.Decode(b,w.key);if e!=nil{return e};command:=binary.BigEndian.Uint32(plain)
+ w.mu.Lock();defer w.mu.Unlock()
+ switch command{case cmdSpeakerStartReq:w.starts++;reply,_:=crypto.Encode(append(binary.BigEndian.AppendUint32(nil,cmdSpeakerStartRes),0,0,0,0),w.key);w.commands<-reply;case cmdSpeakerStop:w.stops++};return nil
+}
+func(w *talkTestWire) WritePacket(h,b []byte)error{w.mu.Lock();defer w.mu.Unlock();w.frames++;return nil}
+func TestTalkClickStartEndAndRepeatOnSameConnection(t *testing.T){
+ w:=&talkTestWire{key:make([]byte,32),commands:make(chan []byte,4)};defer close(w.commands)
+ p:=&Producer{client:&Client{Conn:w,key:w.key,model:ModelLoockV2}}
+ for i:=0;i<2;i++{
+  s,e:=p.BeginTalk(context.Background());if e!=nil{t.Fatal(e)}
+  if _,e=p.BeginTalk(context.Background());e==nil{t.Fatal("second speaker allowed")}
+  if s.WriteFrame(make([]byte,320))==nil{t.Fatal("wrong frame accepted")}
+  if e=s.WriteFrame(make([]byte,480));e!=nil{t.Fatal(e)}
+  if e=s.Close();e!=nil{t.Fatal(e)};s.Close()
+  if s.WriteFrame(make([]byte,480))==nil{t.Fatal("audio accepted after end")}
+ }
+ w.mu.Lock();defer w.mu.Unlock();if w.starts!=2||w.stops!=2||w.frames!=2{t.Fatal(w.starts,w.stops,w.frames)}
+}
+func TestTalkCancellationStopsAndReleasesWriter(t *testing.T){
+ w:=&talkTestWire{key:make([]byte,32),commands:make(chan []byte,4)};defer close(w.commands)
+ p:=&Producer{client:&Client{Conn:w,key:w.key,model:ModelLoockV2}}
+ ctx,cancel:=context.WithCancel(context.Background());s,e:=p.BeginTalk(ctx);if e!=nil{t.Fatal(e)};cancel()
+ deadline:=time.Now().Add(time.Second)
+ for{w.mu.Lock();stopped:=w.stops==1;w.mu.Unlock();if stopped{break};if time.Now().After(deadline){t.Fatal("cancel did not stop speaker")};time.Sleep(time.Millisecond)}
+ if s.WriteFrame(make([]byte,480))==nil{t.Fatal("cancelled audio accepted")}
+ next,e:=p.BeginTalk(context.Background());if e!=nil{t.Fatal("speaker not released",e)};next.Close()
+}
+
+type ptzControlWire struct {
+ Conn
+ controls chan struct{}
+ drained chan struct{}
+}
+
+func (w *ptzControlWire) Protocol() string { return "cs2+udp" }
+func (w *ptzControlWire) SetDeadline(time.Time) error { return nil }
+func (w *ptzControlWire) ReadCommand() (uint32, []byte, error) {
+ if _, ok := <-w.controls; !ok {
+  close(w.drained)
+  return 0, nil, io.EOF
+ }
+ return 0, nil, nil
+}
+func (w *ptzControlWire) ReadPacket() ([]byte, []byte, error) {
+ select {
+ case <-w.drained:
+  return nil, nil, io.EOF
+ case <-time.After(time.Second):
+  return nil, nil, context.DeadlineExceeded
+ }
+}
+
+func TestBalconyLiveDrainsUnsolicitedControls(t *testing.T) {
+ w := &ptzControlWire{controls: make(chan struct{}, 16), drained: make(chan struct{})}
+ for i := 0; i < cap(w.controls); i++ {
+  w.controls <- struct{}{}
+ }
+ close(w.controls)
+ p := &Producer{client: &Client{Conn: w, model: "chuangmi.camera.ipc021"}}
+ if err := p.Start(); !errors.Is(err, io.EOF) || len(w.controls) != 0 {
+  t.Fatalf("control queue did not drain during live playback: %v", err)
+ }
+}
