+}
+
+type catEOFTestConn struct{Conn;control,media int;key []byte;raw []byte}
+func(c *catEOFTestConn)SetDeadline(time.Time)error{return nil}
+func(c *catEOFTestConn)WriteCommand(uint32,[]byte)error{return nil}
+func(c *catEOFTestConn)ReadCommand()(uint32,[]byte,error){c.control++;if c.control>1{return 0,nil,io.EOF};b:=binary.LittleEndian.AppendUint32(nil,uint32(len(c.raw)));return 0x202,b,nil}
+func(c *catEOFTestConn)ReadPacket()([]byte,[]byte,error){c.media++;if c.media>2{return nil,nil,io.EOF};time.Sleep(15*time.Millisecond);header:=make([]byte,32);binary.LittleEndian.PutUint32(header[4:],5);payload:=[]byte("ordinary live video must not be saved");if c.media==2{binary.LittleEndian.PutUint32(header[12:],1<<11);payload=c.raw};data,e:=crypto.Encode(payload,c.key);return header,data,e}
+func TestCatFileDrainsMediaWhenControlChannelEndsFirst(t *testing.T){
+ raw:=append([]byte{0,0,0,24,'f','t','y','p'},make([]byte,16)...);key:=make([]byte,32);conn:=&catEOFTestConn{key:key,raw:raw};c:=&Client{Conn:conn,key:key,model:ModelLoockV2};path:=filepath.Join(t.TempDir(),"clip.mp4")
+ if e:=c.ReadCatSDFile(SDItem{Start:1793872800,Duration:6},time.FixedZone("CST",28800),path);e!=nil{t.Fatal("queued media discarded after control EOF",e)}
+ got,e:=os.ReadFile(path);if e!=nil||string(got)!=string(raw){t.Fatal("complete media was not retained",e)}
+}
+func TestCatCalendarUsesDeviceLocalDateAcrossUTCMidnight(t *testing.T){
+ at:=time.Date(2026,11,5,16,1,2,0,time.UTC).In(time.FixedZone("CST",8*3600));var fields map[string]int
+ json.Unmarshal(catCalendar(at,true),&fields);if fields["day"]!=6||fields["hour"]!=0||fields["minute"]!=1||fields["second"]!=2{t.Fatal(fields)}
+ json.Unmarshal(catCalendar(at,false),&fields);var dateOnly map[string]int;json.Unmarshal(catCalendar(at,false),&dateOnly);if len(dateOnly)!=3||dateOnly["day"]!=6{t.Fatal(dateOnly)}
+}
diff --git a/pkg/xiaomi/miss/cateye_speaker_probe_test.go b/pkg/xiaomi/miss/cateye_speaker_probe_test.go
