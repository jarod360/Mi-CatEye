+package xiaomi
+import("context";"encoding/json";"errors";"net/url";"sync";"time";"github.com/AlexxIT/go2rtc/pkg/core";device "github.com/AlexxIT/go2rtc/pkg/xiaomi")
+var storageGates sync.Map
+func sdModel(model string)bool{return model=="chuangmi.camera.ipc009"||model=="chuangmi.camera.ipc021"||model=="loock.cateye.v02"}
+type storageAccess struct{sync.RWMutex;mu sync.Mutex;cancel context.CancelFunc}
+func(g *storageAccess)setCancel(cancel context.CancelFunc){g.mu.Lock();g.cancel=cancel;g.mu.Unlock()}
+func(g *storageAccess)liveLease(priority bool)bool{
+ if g.TryRLock(){return true};if !priority{return false}
+ g.mu.Lock();cancel:=g.cancel;g.mu.Unlock();if cancel==nil{return false};cancel()
+ until:=time.Now().Add(2*time.Second);for time.Now().Before(until){if g.TryRLock(){return true};time.Sleep(10*time.Millisecond)};return false
+}
+func storageGate(source *url.URL)*storageAccess{key:=source.Host+"/"+source.Query().Get("did");value,_:=storageGates.LoadOrStore(key,&storageAccess{});return value.(*storageAccess)}
+type storageProducer struct{core.Producer;once sync.Once;stopOnce sync.Once;stopErr error;release func()}
+func(p *storageProducer)done(){p.once.Do(p.release)}
+func(p *storageProducer)Start()error{defer p.Stop();return p.Producer.Start()}
+func(p *storageProducer)Stop()error{p.stopOnce.Do(func(){p.stopErr=p.Producer.Stop();p.done()});return p.stopErr}
+func(p *storageProducer)MarshalJSON()([]byte,error){return json.Marshal(p.Producer)}
+func dialWithStorageLease(raw string)(core.Producer,error){
+ source,e:=url.Parse(raw);if e!=nil||!sdModel(source.Query().Get("model")){return device.Dial(raw)}
+ gate:=storageGate(source);if !gate.liveLease(source.Query().Get("model")=="loock.cateye.v02"){return nil,errors.New("storage_device_busy")}
+ producer,e:=device.Dial(raw);if e!=nil{gate.RUnlock();return nil,e}
+ return &storageProducer{Producer:producer,release:gate.RUnlock},nil
+}
