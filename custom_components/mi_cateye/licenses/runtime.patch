index 0000000..95348f3
--- /dev/null
+++ b/pkg/xiaomi/miss/cs2/sd_channel_probe.go
@@ -0,0 +1,28 @@
+package cs2
+
+import (
+ "encoding/binary"
+ "errors"
+ "time"
+ "sync/atomic"
+)
+
+func(c *Conn) ReadChannel(ch int)([]byte,error){
+ if ch!=1{return nil,errors.New("probe_channel_rejected")}
+ b,ok:=c.channels[ch].Pop();if !ok{return nil,c.Error()};return b,nil
+}
+func(c *Conn) WriteChannel(ch byte,payload []byte)error{
+ if ch!=1||len(payload)>4096{return errors.New("probe_channel_rejected")}
+ c.cmdMu.Lock();defer c.cmdMu.Unlock()
+ packet:=make([]byte,12+len(payload));packet[0]=magic;packet[1]=msgDrw
+ binary.BigEndian.PutUint16(packet[2:],uint16(len(packet)-4));packet[4]=magicDrw;packet[5]=ch
+ binary.BigEndian.PutUint16(packet[6:],c.seqCh1);c.seqCh1++
+ binary.BigEndian.PutUint32(packet[8:],uint32(len(payload)));copy(packet[12:],payload)
+ if c.isTCP{_,err:=c.Conn.Write(packet);return err}
+ var acknowledged atomic.Bool;c.cmdAck=func(){acknowledged.Store(true)}
+ for attempt:=0;attempt<3;attempt++{
+  if _,err:=c.Conn.Write(packet);err!=nil{return err}
+  for i:=0;i<20;i++{if acknowledged.Load(){return nil};time.Sleep(25*time.Millisecond)}
+ }
+ return errors.New("probe_channel_ack_timeout")
+}
