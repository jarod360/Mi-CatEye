+package miss
+import("bytes";"encoding/binary";"os";"path/filepath";"testing";"time";"github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto")
+type fileProbeConn struct{Conn;chunks [][]byte;key []byte;request []byte}
+func(f *fileProbeConn)SetDeadline(time.Time)error{return nil}
+func(f *fileProbeConn)WriteChannel(ch byte,b []byte)error{f.request,_=crypto.Decode(b,f.key);return nil}
+func(f *fileProbeConn)ReadChannel(int)([]byte,error){b:=f.chunks[0];f.chunks=f.chunks[1:];return crypto.Encode(b,f.key)}
+func TestFileProbeChecksHeaderAndExactLength(t *testing.T){
+ for _,tc:=range []struct{name string;cmd,size,status uint32;body []byte;stage string;fail bool}{
+  {"success",1,8,0,[]byte("testdata"),"recording_file_received",false},
+  {"wrong-command",6,0,0,nil,"file_header_rejected",false},
+  {"nonzero-status",1,0,7,nil,"file_header_rejected",false},
+  {"empty",1,0,0,nil,"file_not_found",false},
+  {"oversize",1,17<<20,0,nil,"",true},
+  {"trailing",1,2,0,[]byte("excess"),"",true},
+ }{t.Run(tc.name,func(t *testing.T){
+  h:=make([]byte,12);binary.LittleEndian.PutUint32(h,tc.cmd);binary.LittleEndian.PutUint32(h[4:],tc.size);binary.LittleEndian.PutUint32(h[8:],tc.status)
+  f:=&fileProbeConn{key:make([]byte,32),chunks:[][]byte{h[:5],append(h[5:],tc.body...)}};c:=&Client{Conn:f,key:f.key}
+  path:=filepath.Join(t.TempDir(),"sample");r,e:=c.ProbeSDFile(SDItem{Start:1793800000,Duration:60},path)
+  if (e!=nil)!=tc.fail{t.Fatalf("unexpected result %v",e)};if !tc.fail&&r["stage"]!=tc.stage{t.Fatal(r)}
+  if binary.LittleEndian.Uint32(f.request)!=1||binary.LittleEndian.Uint32(f.request[8:])!=1793800000{t.Fatal("request is not exact existing file time")}
+  if tc.name=="success"{b,_:=os.ReadFile(path);if !bytes.Equal(b,tc.body){t.Fatal("file body changed")}}
+ })}
+}
diff --git a/pkg/xiaomi/miss/sd_timeline_probe.go b/pkg/xiaomi/miss/sd_timeline_probe.go
new file mode 100644
index 0000000..b4823ee
--- /dev/null
+++ b/pkg/xiaomi/miss/sd_timeline_probe.go
@@ -0,0 +1,48 @@
+package miss
+
+import (
+ "encoding/binary"
+ "errors"
+ "time"
+ "github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+)
+
+const sdIndexLimit=2*1024*1024
+type SDItem struct{Start int64;Duration int;Marked bool}
+
+func parseSDIndex(data []byte)([]SDItem,error){
+ if len(data)<12||binary.LittleEndian.Uint32(data)!=6{return nil,errors.New("index_header_invalid")}
+ n:=int(binary.LittleEndian.Uint32(data[4:]));status:=binary.LittleEndian.Uint32(data[8:])
+ if status!=0{return nil,errors.New("index_status_nonzero")}
+ if n>sdIndexLimit||n%8!=0||len(data)!=12+n{return nil,errors.New("index_length_invalid")}
+ items:=make([]SDItem,0,n/8)
+ for offset:=12;offset<len(data);offset+=8{
+  row:=data[offset:offset+8];start:=int64(binary.LittleEndian.Uint32(row))
+  if row[7]&1!=0||start==0||row[4]==0{continue}
+  items=append(items,SDItem{Start:start,Duration:int(row[4]),Marked:row[5]==1})
+ }
+ return items,nil
+}
+
+// ReadSDIndex is experimental and read-only. It owns a dedicated, non-video
+// connection in a maintenance window, so its socket deadline cannot hurt live view.
+func(c *Client) ReadSDIndex()([]SDItem,error){
+ channel,ok:=c.Conn.(interface{WriteChannel(byte,[]byte)error;ReadChannel(int)([]byte,error)})
+ if !ok{return nil,errors.New("index_transport_unsupported")}
+ _=c.SetDeadline(time.Now().Add(10*time.Second));defer c.SetDeadline(time.Time{})
+ request,err:=crypto.Encode([]byte{6,0,0,0,0,0,0,0},c.key);if err!=nil{return nil,errors.New("index_encode_failed")}
+ if err=channel.WriteChannel(1,request);err!=nil{return nil,errors.New("index_send_failed")}
+ data:=make([]byte,0,4096);want:=-1
+ for want<0||len(data)<want{
+  chunk,err:=channel.ReadChannel(1);if err!=nil{return nil,errors.New("index_read_timeout_or_closed")}
+  if len(chunk)<8||len(chunk)>65536{return nil,errors.New("index_chunk_invalid")}
+  plain,err:=crypto.Decode(chunk,c.key);if err!=nil{return nil,errors.New("index_decode_failed")}
+  if len(data)+len(plain)>sdIndexLimit+12{return nil,errors.New("index_size_limit")}
+  data=append(data,plain...)
+  if want<0&&len(data)>=12{
+   n:=int(binary.LittleEndian.Uint32(data[4:]));if n>sdIndexLimit||n%8!=0{return nil,errors.New("index_length_invalid")}
+   want=12+n
+  }
+ }
+ return parseSDIndex(data)
+}
