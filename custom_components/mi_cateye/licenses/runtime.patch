index 0000000..35787ac
--- /dev/null
+++ b/pkg/xiaomi/miss/audio_write_test.go
@@ -0,0 +1,29 @@
+package miss
+
+import (
+ "bytes"
+ "encoding/binary"
+ "errors"
+ "testing"
+ "github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+)
+
+type audioCapture struct {Conn; headers,payloads [][]byte; fail bool}
+func(c *audioCapture) WritePacket(h,p []byte)error{
+ if c.fail{return errors.New("test write failure")}
+ c.headers=append(c.headers,append([]byte(nil),h...));c.payloads=append(c.payloads,append([]byte(nil),p...));return nil
+}
+func TestAudioFrameSequenceAndEncryptedPayload(t *testing.T){
+ socket:=&audioCapture{}
+ c:=&Client{Conn:socket,key:make([]byte,32)}
+ audio:=bytes.Repeat([]byte{0x29,0x72},160)
+ for i:=uint32(0);i<3;i++{
+  if err:=c.WriteAudio(codecPCMA,audio);err!=nil{t.Fatal(err)}
+  h:=socket.headers[i];p:=socket.payloads[i]
+  if binary.LittleEndian.Uint32(h[8:])!=i{t.Fatal("repeated audio frame sequence")}
+  if binary.LittleEndian.Uint32(h[4:])!=codecPCMA||int(binary.LittleEndian.Uint32(h))!=len(p){t.Fatal("invalid audio metadata")}
+  decoded,err:=crypto.Decode(p,c.key);if err!=nil||!bytes.Equal(decoded,audio){t.Fatal("corrupt encrypted audio")}
+ }
+ socket.fail=true
+ if c.WriteAudio(codecPCMA,audio)==nil||c.audioSeq!=3{t.Fatal("failure was hidden or advanced sequence")}
+}
diff --git a/pkg/xiaomi/miss/cat_storage.go b/pkg/xiaomi/miss/cat_storage.go
new file mode 100644
index 0000000..68745b1
--- /dev/null
+++ b/pkg/xiaomi/miss/cat_storage.go
@@ -0,0 +1,80 @@
+package miss
+
+import (
+ "bytes"
+ "encoding/binary"
+ "encoding/json"
+ "errors"
+ "os"
+ "time"
+ "github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+)
+
+const catFileLimit=16*1024*1024
+
+// The validated Chinese cat-eye firmware uses local calendar fields. Caller
+// supplies the timezone explicitly; records themselves remain Unix timestamps.
+func catCalendar(at time.Time,full bool)[]byte{
+ p:=map[string]int{"year":at.Year(),"month":int(at.Month()),"day":at.Day()}
+ if full{p["hour"]=at.Hour();p["minute"]=at.Minute();p["second"]=at.Second()}
+ b,_:=json.Marshal(p);return b
+}
+func parseCatIndex(data []byte)([]SDItem,error){
+ if len(data)>sdIndexLimit||len(data)%8!=0{return nil,errors.New("sd_index_failed")}
+ rows:=make([]SDItem,0,len(data)/8)
+ for i:=0;i<len(data);i+=8{b:=data[i:i+8];start:=int64(binary.LittleEndian.Uint32(b));if start==0||b[4]==0||b[7]!=0{continue};rows=append(rows,SDItem{Start:start,Duration:int(b[4]),Marked:b[5]==1})}
+ return rows,nil
+}
+func(c *Client)catCommand()(uint32,[]byte,error){
+ cmd,b,e:=c.Conn.ReadCommand();if e!=nil{return 0,nil,e}
+ if cmd==cmdEncoded{b,e=crypto.Decode(b,c.key);if e!=nil||len(b)<4{return 0,nil,errors.New("sd_index_failed")};cmd=binary.BigEndian.Uint32(b);b=b[4:]}
+ return cmd,b,nil
+}
+func(c *Client)ReadCatSDIndex(day time.Time)([]SDItem,error){
+ if c.model!=ModelLoockV2{return nil,errors.New("sd_not_supported")}
+ _=c.SetDeadline(time.Now().Add(12*time.Second));defer c.SetDeadline(time.Time{})
+ if e:=c.WriteCommand(append(binary.BigEndian.AppendUint32(nil,0x206),catCalendar(day,false)...));e!=nil{return nil,e}
+ want:=-1;data:=[]byte{}
+ for n:=0;n<1024;n++{
+  cmd,b,e:=c.catCommand();if e!=nil{return nil,errors.New("sd_index_failed")}
+  switch cmd{
+  case 0x208:if len(b)<4{return nil,errors.New("sd_index_failed")};want=int(binary.LittleEndian.Uint32(b));if want<0||want>sdIndexLimit||want%8!=0{return nil,errors.New("sd_index_failed")}
+  case 0x207:if len(data)+len(b)>sdIndexLimit{return nil,errors.New("sd_index_failed")};data=append(data,b...)
+  case 0x20f:return nil,errors.New("sd_index_failed")
+  }
+  if want>=0&&len(data)>want{return nil,errors.New("sd_index_failed")};if want>=0&&len(data)==want{return parseCatIndex(data)}
+ }
+ return nil,errors.New("sd_index_failed")
+}
+
+func(c *Client)ReadCatSDFile(item SDItem,zone *time.Location,path string)error{
+ if c.model!=ModelLoockV2||item.Start<1262304000||item.Duration<1||item.Duration>3600||zone==nil{return errors.New("sd_not_supported")}
+ want:=-1;data:=[]byte{};ended:=0;counts:=map[uint32]int{};readErrors:=[]string{}
+ fail:=func(stage string)error{b,_:=json.Marshal(map[string]any{"stage":stage,"expected":want,"received":len(data),"readers_ended":ended,"commands":counts,"read_errors":readErrors});_ =os.WriteFile(path+".failure.json",b,0600);return errors.New("sd_file_failed")}
+ _=c.SetDeadline(time.Now().Add(32*time.Second));defer c.SetDeadline(time.Time{})
+ // File length is an IO-control response, but original MP4 bytes arrive as
+ // encrypted media chunks (the OEM JPEG callback), not normal control replies.
+ type event struct{cmd uint32;body []byte;err error}
+ events:=make(chan event,16);done:=make(chan struct{});defer close(done)
+ send:=func(ev event)bool{select{case events<-ev:return true;case <-done:return false}}
+ go func(){for{cmd,b,e:=c.catCommand();if e==nil&&cmd==0x201{continue};if !send(event{cmd,b,e})||e!=nil{return}}}()
+ // OEM isPlayback = (MISS flags >> 11) & 1. Ordinary video may still be
+ // emitted on this connection and must never be concatenated into an MP4.
+ go func(){for{p,e:=c.ReadPacket();if e!=nil{send(event{err:e});return};if p.Flags&(1<<11)==0{continue};if !send(event{cmd:0x201,body:p.Payload}){return}}}()
+ if e:=c.WriteCommand(append(binary.BigEndian.AppendUint32(nil,0x200),catCalendar(time.Unix(item.Start,0).In(zone),true)...));e!=nil{return fail("send_failed")}
+ timer:=time.NewTimer(32*time.Second);defer timer.Stop()
+ for n:=0;n<8192;n++{
+  var ev event;select{case ev=<-events:case <-timer.C:return fail("timeout")};if ev.err!=nil{ended++;text:=ev.err.Error();if len(text)>120{text="read_error"};readErrors=append(readErrors,text);if ended==2{return fail("readers_ended")};continue};counts[ev.cmd]++
+  switch ev.cmd{
+  case 0x202:if len(ev.body)<4{return fail("size_header")};want=int(binary.LittleEndian.Uint32(ev.body));if want<16||want>catFileLimit{return fail("size_limit")}
+  case 0x201:if len(data)+len(ev.body)>catFileLimit{return fail("content_limit")};data=append(data,ev.body...)
+  case 0x20f:return fail("device_error")
+  }
+  if want>0&&len(data)>want{return fail("length_overflow")}
+  if want>0&&len(data)==want{
+   if !bytes.Contains(data[:16],[]byte("ftyp")){return fail("format")}
+   if e:=os.WriteFile(path,data,0600);e!=nil{return fail("write_failed")};return nil
+  }
+ }
+ return fail("packet_limit")
+}
