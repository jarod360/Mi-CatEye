index 0000000..913196f
--- /dev/null
+++ b/pkg/tutk/sd_rdt_probe.go
@@ -0,0 +1,85 @@
+// Experimental fixed-channel MISS RDT interoperability. No AV or storage writes.
+package tutk
+import("encoding/binary";"errors";"sync";"sync/atomic";"time")
+const sdRDTMagic uint32=0xf1c2975a
+type sdRDTState struct{
+ c *Conn;sendMu sync.Mutex;outer uint16;peer atomic.Uint32
+ ready chan struct{};readyOnce sync.Once;done chan struct{};doneOnce sync.Once
+ chunks chan []byte;acks chan uint64;rx uint64;tx uint64;future map[uint64][]byte;buffer []byte
+ frames atomic.Uint32;dataBytes atomic.Uint32;hello atomic.Uint32
+}
+func rdtProbePacket(kind byte,seq uint64,id byte,payload []byte)[]byte{
+ b:=make([]byte,20+len(payload));binary.LittleEndian.PutUint32(b,sdRDTMagic);b[4]=kind;b[5]=5
+ binary.LittleEndian.PutUint16(b[6:],uint16(len(payload)));binary.LittleEndian.PutUint64(b[8:],seq);b[17]=id;copy(b[20:],payload);return b
+}
+func(s *sdRDTState)send(packet []byte)error{
+ s.sendMu.Lock();defer s.sendMu.Unlock()
+ maker,ok:=s.c.session.(interface{Msg(uint16)[]byte});if !ok{return errors.New("rdt_session_unsupported")}
+ frame:=maker.Msg(uint16(28+len(packet)));frame[8]=8;frame[10]=0x12;frame[14]=5
+ binary.LittleEndian.PutUint16(frame[6:],s.outer);s.outer++;copy(frame[28:],packet)
+ _,e:=s.c.Write(frame);return e
+}
+func(c *Conn)OpenSDChannel5()error{
+ s:=&sdRDTState{c:c,ready:make(chan struct{}),done:make(chan struct{}),chunks:make(chan []byte,256),acks:make(chan uint64,16),future:map[uint64][]byte{}}
+ s.peer.Store(c.sdPeer5.Load())
+ c.sdMu.Lock();if c.sdRDT!=nil{c.sdMu.Unlock();return errors.New("rdt_already_open")};c.sdRDT=s;c.sdMu.Unlock()
+ for n:=0;n<3;n++{
+  if e:=s.send(rdtProbePacket(1,0,1,nil));e!=nil{return errors.New("rdt_hello_send_failed")}
+  select{case <-s.ready:return nil;case <-s.done:return errors.New("rdt_handshake_closed");case <-time.After(time.Second):}
+ }
+ return errors.New("rdt_handshake_timeout")
+}
+func(c *Conn)closeSDChannel(){c.sdMu.Lock();defer c.sdMu.Unlock();if c.sdRDT!=nil{c.sdRDT.doneOnce.Do(func(){close(c.sdRDT.done)})}}
+func(c *Conn)Close()error{c.sdMu.Lock();s:=c.sdRDT;c.sdMu.Unlock();if s!=nil{_ = s.send(rdtProbePacket(4,0,byte(s.peer.Load()),nil));c.closeSDChannel()};return c.UDPConn.Close()}
+func(c *Conn)receiveSDFrame(frame []byte)bool{
+ if len(frame)<48||frame[14]!=5||binary.LittleEndian.Uint32(frame[28:])!=sdRDTMagic{return false}
+ if frame[32]==1{c.sdPeer5.Store(uint32(frame[45]))}
+ c.sdMu.Lock();s:=c.sdRDT;c.sdMu.Unlock();if s==nil{return false}
+ b:=frame[28:];n:=int(binary.LittleEndian.Uint16(b[6:]));if b[5]!=5||n>4096||len(b)!=20+n{c.closeSDChannel();return true}
+ seq:=binary.LittleEndian.Uint64(b[8:]);kind:=b[4]
+ s.frames.Add(1)
+ switch kind{
+ case 1:s.hello.Add(1);s.peer.Store(uint32(b[17]));ack:=append([]byte(nil),b[:20]...);ack[4]=0x41;_ = s.send(ack)
+ case 0x41:s.readyOnce.Do(func(){close(s.ready)})
+ case 0x42,0x46:select{case s.acks<-seq:default:}
+ case 2:
+  s.dataBytes.Add(uint32(n))
+  if seq>=s.rx{
+   if seq-s.rx>64||len(s.future)>=64{c.closeSDChannel();return true}
+   if s.future[seq]==nil{s.future[seq]=append([]byte(nil),b[20:]...)}
+   for{data,ok:=s.future[s.rx];if !ok{break};select{case s.chunks<-data:delete(s.future,s.rx);s.rx++;default:c.closeSDChannel();return true}}
+  }
+  ack:=append([]byte(nil),b[:20]...);ack[4]=0x42;ack[6]=0;ack[7]=0;ack[17]=byte(s.peer.Load());_ = s.send(ack)
+  if s.rx>0{_ = s.send(rdtProbePacket(0x46,s.rx-1,byte(s.peer.Load()),nil))}
+ case 3:_=s.send(rdtProbePacket(0x43,seq,byte(s.peer.Load()),nil))
+ case 4,0x20:c.closeSDChannel()
+ }
+ return true
+}
+func(c *Conn)SDChannelDiagnostics()map[string]any{
+ c.sdMu.Lock();s:=c.sdRDT;c.sdMu.Unlock();if s==nil{return map[string]any{"rdt_open":false}}
+ return map[string]any{"rdt_frames":s.frames.Load(),"rdt_data_bytes":s.dataBytes.Load(),"rdt_peer":s.peer.Load(),"rdt_hello":s.hello.Load()}
+}
+func(c *Conn)WriteChannel(ch byte,payload []byte)error{
+ if ch!=1||len(payload)>4096{return errors.New("rdt_request_rejected")}
+ c.sdMu.Lock();s:=c.sdRDT;c.sdMu.Unlock();if s==nil{return errors.New("rdt_not_open")}
+ data:=binary.BigEndian.AppendUint32(nil,uint32(len(payload)));data=append(data,payload...)
+ for len(data)>0{
+  n:=min(1000,len(data));packet:=rdtProbePacket(2,s.tx,byte(s.peer.Load()),data[:n]);acked:=false
+  for attempt:=0;attempt<3&&!acked;attempt++{
+   if e:=s.send(packet);e!=nil{return errors.New("rdt_write_failed")}
+   timer:=time.NewTimer(time.Second)
+  wait:for{select{case seq:=<-s.acks:if seq==s.tx{acked=true;break wait};case <-timer.C:break wait;case <-s.done:timer.Stop();return errors.New("rdt_closed")}}
+   timer.Stop()
+  }
+  if !acked{return errors.New("rdt_ack_timeout")};s.tx++;data=data[n:]
+ }
+ return nil
+}
+func(c *Conn)ReadChannel(ch int)([]byte,error){
+ if ch!=1{return nil,errors.New("rdt_channel_rejected")};c.sdMu.Lock();s:=c.sdRDT;c.sdMu.Unlock();if s==nil{return nil,errors.New("rdt_not_open")}
+ for{
+  if len(s.buffer)>=4{n:=int(binary.BigEndian.Uint32(s.buffer));if n<8||n>65536{return nil,errors.New("rdt_frame_limit")};if len(s.buffer)>=4+n{data:=append([]byte(nil),s.buffer[4:4+n]...);s.buffer=s.buffer[4+n:];return data,nil}}
+  select{case data:=<-s.chunks:if len(s.buffer)+len(data)>128*1024{return nil,errors.New("rdt_buffer_limit")};s.buffer=append(s.buffer,data...);case <-s.done:return nil,errors.New("rdt_closed");case <-time.After(12*time.Second):return nil,errors.New("rdt_read_timeout")}
+ }
+}
