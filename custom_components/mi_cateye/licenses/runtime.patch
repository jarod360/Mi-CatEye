diff --git a/internal/xiaomi/cateye_talk.go b/internal/xiaomi/cateye_talk.go
new file mode 100644
index 0000000..6f900c4
--- /dev/null
+++ b/internal/xiaomi/cateye_talk.go
@@ -0,0 +1,100 @@
+package xiaomi
+
+import (
+ "context"
+ "crypto/rand"
+ "encoding/hex"
+ "encoding/json"
+ "errors"
+ "io"
+ "net/http"
+ "sync"
+ "time"
+ "github.com/AlexxIT/go2rtc/internal/api"
+ "github.com/AlexxIT/go2rtc/internal/streams"
+ "github.com/AlexxIT/go2rtc/pkg/xiaomi/miss"
+)
+
+type talkWriter interface{WriteFrame([]byte)error;Close()error}
+type talkOwner struct{id string;writer talkWriter;cancel context.CancelFunc;upload,listen bool}
+type talkAPI struct{mu sync.Mutex;active *talkOwner;begin func(context.Context)(talkWriter,error)}
+func InitTalk(){
+ h:=&talkAPI{begin:func(ctx context.Context)(talkWriter,error){
+  stream:=streams.Get("doorbell_live");if stream==nil{return nil,errors.New("live_video_required")}
+  p,e:=stream.ActiveProducer();if e!=nil{return nil,e}
+  if leased,ok:=p.(*storageProducer);ok{p=leased.Producer}
+  camera,ok:=p.(*miss.Producer);if !ok{return nil,errors.New("talk_source_unsupported")}
+  return camera.BeginTalk(ctx)
+ }}
+ api.HandleFunc("api/doorbell/talk",h.serve)
+}
+func(h *talkAPI) close(owner *talkOwner){
+ h.mu.Lock();defer h.mu.Unlock()
+ if h.active!=owner{return};owner.cancel();owner.writer.Close();h.active=nil
+}
+func(h *talkAPI) serve(w http.ResponseWriter,r *http.Request){
+ if r.Method!=http.MethodPost{w.WriteHeader(405);return}
+ w.Header().Set("Cache-Control","no-store")
+ switch r.URL.Query().Get("action"){
+ case "begin":
+  h.mu.Lock()
+  if h.active!=nil{h.mu.Unlock();http.Error(w,"talk_busy",409);return}
+  ctx,cancel:=context.WithTimeout(context.Background(),60*time.Second)
+  writer,e:=h.begin(ctx)
+  if e!=nil{
+   cancel();h.mu.Unlock()
+   reason:="talk_transport_unavailable"
+   switch e.Error(){case "live_video_required","single_active_producer_required","live_producer_unavailable","talk_source_unsupported","talk_model_unsupported","talk_already_active","talk_start_timeout","talk_start_rejected":reason=e.Error()}
+   w.Header().Set("Content-Type","application/json");w.WriteHeader(409)
+   json.NewEncoder(w).Encode(map[string]string{"error":reason});return
+  }
+  nonce:=make([]byte,24);if _,e=rand.Read(nonce);e!=nil{writer.Close();cancel();h.mu.Unlock();w.WriteHeader(500);return}
+  owner:=&talkOwner{id:hex.EncodeToString(nonce),writer:writer,cancel:cancel};h.active=owner;h.mu.Unlock()
+  go func(){<-ctx.Done();h.close(owner)}()
+  go func(){
+   select{case <-ctx.Done():return;case <-time.After(3*time.Second):}
+   h.mu.Lock();abandoned:=h.active==owner&&!owner.upload;h.mu.Unlock()
+   if abandoned{h.close(owner)}
+  }()
+  w.Header().Set("Content-Type","application/json")
+  json.NewEncoder(w).Encode(map[string]any{"session":owner.id,"max_seconds":60,"frame_bytes":480,"sample_rate":8000})
+ case "audio","end","listen":
+  id:=r.Header.Get("X-Talk-Session")
+  h.mu.Lock();owner:=h.active
+  if owner==nil||len(id)!=48||id!=owner.id{h.mu.Unlock();http.Error(w,"talk_session_unavailable",404);return}
+  if r.URL.Query().Get("action")=="end"{h.mu.Unlock();h.close(owner);w.WriteHeader(204);return}
+  if r.URL.Query().Get("action")=="listen"{
+   if owner.listen{h.mu.Unlock();w.WriteHeader(409);return}
+   reader,ok:=owner.writer.(interface{PCM()(<-chan []byte,<-chan struct{},error)})
+   if !ok{h.mu.Unlock();w.WriteHeader(409);return}
+   owner.listen=true;h.mu.Unlock();defer h.close(owner)
+   frames,done,e:=reader.PCM();if e!=nil{w.WriteHeader(409);return}
+   w.Header().Set("Content-Type","audio/pcm;rate=8000;channels=1;format=s16le");w.WriteHeader(200)
+   controller:=http.NewResponseController(w);controller.Flush()
+   for{
+    select{
+    case <-done:return
+    case <-r.Context().Done():return
+    case <-time.After(2*time.Second):return
+    case b:=<-frames:
+     controller.SetWriteDeadline(time.Now().Add(2*time.Second))
+     if _,e=w.Write(b);e!=nil{return};if controller.Flush()!=nil{return}
+    }
+   }
+  }
+  if owner.upload{h.mu.Unlock();http.Error(w,"talk_upload_busy",409);return}
+  if r.Header.Get("Content-Type")!="audio/pcma"{h.mu.Unlock();w.WriteHeader(415);return}
+  owner.upload=true;h.mu.Unlock();defer h.close(owner)
+  // A stalled uplink must not leave the speaker open.
+  controller:=http.NewResponseController(w);frame:=make([]byte,480)
+  for count:=0;count<1000;count++{
+   controller.SetReadDeadline(time.Now().Add(2*time.Second))
+   n,e:=io.ReadFull(r.Body,frame)
+   if e==io.EOF&&n==0{w.WriteHeader(204);return}
+   if e!=nil{http.Error(w,"talk_audio_interrupted",400);return}
+   if e=owner.writer.WriteFrame(frame);e!=nil{http.Error(w,"talk_audio_stopped",409);return}
+  }
+  http.Error(w,"talk_time_limit",408)
+ default:w.WriteHeader(400)
+ }
+}
